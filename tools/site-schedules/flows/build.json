{
  "title": "flow.build.title",
  "enabled": true,
  "trigger": {
    "type": "button",
    "data": "quotes"
  },
  "run_as": "starter",
  "start": "s1",
  "steps": {
    "s1": {
      "type": "require",
      "match": "all",
      "when": [
        {
          "left": "{{trigger.row.site_name}}",
          "op": "not_empty"
        },
        {
          "left": "{{trigger.row.checks_done}}",
          "op": "gte",
          "value": "{{trigger.row.checks_n}}"
        }
      ],
      "message": "Tick every line under What to check first (and make sure the site name is filled in): the agreement is made from what the row says.",
      "next": "s2"
    },
    "s2": {
      "type": "action",
      "action": "swiftnet.build_agreement",
      "data": "quotes",
      "row": "{{trigger.row.id}}",
      "in": {
        "details": "details",
        "site_name": "site_name",
        "company": "company",
        "lease_type": "lease_type",
        "start_date": "start_date",
        "term_years": "term_years",
        "term_months": "term_months",
        "esc_year": "esc_year",
        "col_id": "col_id",
        "contract_no": "contract_no",
        "soc_no": "soc_no",
        "t100_ref": "t100_ref",
        "t000_ref": "t000_ref",
        "co_code": "co_code",
        "lease_code": "lease_code",
        "swiftnet_rep": "swiftnet_rep",
        "couser_rep": "couser_rep",
        "stac": "stac",
        "pid": "pid",
        "region": "region",
        "lat": "lat",
        "lon": "lon",
        "struct_name": "struct_name",
        "struct_cat": "struct_cat",
        "site_owner": "site_owner",
        "co_site_name": "co_site_name",
        "bs_site_no": "bs_site_no",
        "co_region": "co_region",
        "mast_cat": "mast_cat",
        "mast_hagl": "mast_hagl",
        "inst_hagl": "inst_hagl",
        "scope": "scope",
        "equip_comments": "equip_comments",
        "swift_signers": "swift_signers",
        "couser_signers": "couser_signers"
      },
      "out": {
        "agreement": "agreement"
      },
      "next": "s3"
    },
    "s3": {
      "type": "update_row",
      "data": "quotes",
      "row": "{{trigger.row.id}}",
      "values": {
        "status": "Built"
      }
    }
  }
}