{
  "title": "flow.reopened.title",
  "enabled": true,
  "trigger": {
    "type": "row_changed",
    "data": "tasks"
  },
  "run_as": "starter",
  "start": "if1",
  "steps": {
    "s1": {
      "type": "update_row",
      "data": "tasks",
      "row": "{{trigger.row.id}}",
      "values": {
        "finished": "",
        "done_by": ""
      }
    },
    "if1": {
      "type": "if",
      "match": "all",
      "when": [
        {
          "left": "{{trigger.row.status}}",
          "op": "not_equals",
          "value": "Done"
        },
        {
          "left": "{{trigger.row.finished}}",
          "op": "not_empty"
        }
      ],
      "yes": "s1"
    }
  }
}
