{
  "kind": "table",
  "title": "data.job_tasks.title",
  "scope": "members",
  "write": "everyone",
  "members": {
    "table": "job_members",
    "person": "person",
    "link": "job",
    "through": "job",
    "only": {
      "status": "Active"
    }
  },
  "columns": [
    {
      "key": "job",
      "label": "col.job",
      "type": "link",
      "table": "jobs",
      "show": "title",
      "required": true
    },
    {
      "key": "title",
      "label": "col.title",
      "type": "text",
      "required": true
    },
    {
      "key": "who",
      "label": "col.who",
      "type": "person"
    },
    {
      "key": "status",
      "label": "col.status",
      "type": "choice",
      "options": [
        "To do",
        "Doing",
        "Done"
      ],
      "default": "To do"
    },
    {
      "key": "steps",
      "label": "col.steps",
      "type": "checklist"
    },
    {
      "key": "due",
      "label": "col.due",
      "type": "date"
    }
  ]
}
