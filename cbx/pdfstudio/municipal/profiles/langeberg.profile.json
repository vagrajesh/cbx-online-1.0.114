   "pattern": "^[\\s\\S]*^[ \\t]*\\d{4,}[ \\t]+\\d{2}/\\d{2}/\\d{4}[ \\t]+(\\d{2}/\\d{2}/\\d{4})[ \\t]+\\d+[ \\t]",
   "type": "date",
   "required": false
  },
  {
   "field": "x_exclusive",
