   "scope": "section:electricity",
   "pattern": "^[ \\t]*\\d{4,}[ \\t]+\\d{2}/\\d{2}/\\d{4}[ \\t]+\\d{2}/\\d{2}/\\d{4}[^\\n]*Kwh/KVA[^\\n]*?[ \\t]{2,}(-?(?:\\d{1,3}(?: \\d{3})+|\\d*),\\d{2})[ \\t]*$",
   "type": "money",
   "collect": "sum",
   "required": false
  },
  {
   "field": "x_bbf",
   "label": "Balance Brought Forward",
   "scope": "document",
   "pattern": "Balance Brought Forward[^\\n]*?[ \\t](-?(?:\\d{1,3}(?: \\d{3})+|\\d*),\\d{2})[ \\t]*$",
   "type": "money",
   "required": false
  },
  {
   "field": "x_payments",
   "label": "Payments (credit)",
   "scope": "document",
   "pattern": "^[ \\t]*\\d{2}/\\d{2}/\\d{4}[ \\t]+\\d[\\d-]*[ \\t]{2,}(?:-?(?:\\d{1,3}(?: \\d{3})+|\\d*),\\d{2})[ \\t]{2,}(-?(?:\\d{1,3}(?: \\d{3})+|\\d*),\\d{2})[ \\t]{2,}(?:-?(?:\\d{1,3}(?: \\d{3})+|\\d*),\\d{2})[ \\t]*$",
   "type": "money",
   "collect": "sum",
   "required": false
  },
  {
   "field": "x_interest",
   "label": "Interest",
   "scope": "document",
   "pattern": "^[ \\t]*\\d{2}/\\d{2}/\\d{4}[ \\t]+Interest\\b[^\\n]*?[ \\t]{2,}(?:-?(?:\\d{1,3}(?: \\d{3})+|\\d*),\\d{2})[ \\t]{2,}(-?(?:\\d{1,3}(?: \\d{3})+|\\d*),\\d{2})[ \\t]{2,}(?:-?(?:\\d{1,3}(?: \\d{3})+|\\d*),\\d{2})[ \\t]*$",
   "type": "money",
   "collect": "sum",
   "required": false
  },
  {
   "field": "x_total_vat",
   "label": "TOTAL VAT AMOUNT",
   "scope": "document",
   "pattern": "TOTAL VAT AMOUNT[ \\t]+(-?(?:\\d{1,3}(?: \\d{3})+|\\d*),\\d{2})",
   "type": "money",
   "required": false
  },
  {
   "field": "x_total_due",
   "label": "TOTAL AMOUNT DUE",
   "scope": "document",
   "pattern": "TOTAL AMOUNT DUE[ \\t]+(-?(?:\\d{1,3}(?: \\d{3})+|\\d*),\\d{2})",
   "type": "money",
   "required": false
  }
 ],
 "computes": [
  {
   "field": "lg_basic_r",
   "op": "sub",
   "of": [
