{
 "profile_id": "mthonjaneni",
 "profile_name": "Mthonjaneni Local Municipality (Melmoth, KwaZulu-Natal)",
 "short_name": "Mthonjaneni",
 "_doc": "Mthonjaneni (folder 'MTHONJENI LOCAL MUNICIPALITY'; the bill spells it Mthonjaneni) prints a ledger-style 'TAX INVOICE /STATEMENT': masthead with the municipality's own VAT No. 4210104750, Month / Statement Date / Due Date, an ERF/Deposit grid, then a ledger (Date | Description | VAT | Debit | Credit | Balance) grouped under service headings ('Electricity Basic', 'Electricity Cosnumption' [sic], or plain 'Electricity' on newer prints; then 'Interest on Arrears'/'Interest', 'Payments', 'Refuse Removal'/'Waste Management'), a meter detail table under the consumption line (Date From / Date To / Band / Rate / Units / '<n>KW - [start to end]' / Reading Type / Exclusive) with the meter number on the next line, an aging strip and 'VAT Total'. Page 2 repeats the masthead and carries the refuse line. Debit is VAT-inclusive; ex-VAT per line = Debit - VAT. Account = the printed 'Reference:' value; billing_date = Statement Date. total_ex_vat_r = (basic Debit - VAT) + (consumption Debit - VAT), payment lines ('Payment - Electricity Basic') and interest excluded; other_r = basic, standard_r = consumption (single flat kWh band). Fingerprint: VAT 4210104750 + 'Mthonjaneni'. IDENTITY mth_ident_ex = basic ex + the meter table's printed 'Exclusive' amount (independent for the consumption part, circular for the basic part): 0.00 on 6/11, <=0.01 on 5/11 (rate rounding). Second check: electricity VAT / 0.15 matches total_ex within 5c on 11/11, and VAT Total = electricity VAT + refuse VAT on 11/11. Checked on 11 bills (two are the same February statement); a refuse row is also emitted.",
 "fingerprint": {
  "all": [
   "4210104750",
   "Mthonjaneni"
  ],
  "any": [],
  "reject_if_text": []
 },
 "sections": {
  "electricity": {
   "start": "^Electricity(?:[ \\t]+(?:Basic|Cosnumption|Consumption))?[ \\t]*$",
   "require": "^[ \\t]*\\d{2}/\\d{2}/\\d{4}[ \\t]+Electricity (?:basic|Consumption)"
  },
  "sundry": {
   "start": "^(?:Interest on Arrears|Interest|Payments)[ \\t]*$"
  },
  "refuse": {
   "start": "^[ \\t]*\\d{2}/\\d{2}/\\d{4}[ \\t]+Refuse Removal\\b",
   "overlay": true,
   "end": "^[ \\t]*\\d{2}/\\d{2}/\\d{4}[ \\t]+Refuse Removal[^\\n]*$"
  }
 },
