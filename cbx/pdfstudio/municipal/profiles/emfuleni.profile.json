        "money"
      ],
      "label": "Refuse charges",
      "scope": "section:refuse",
      "collect": "sum",
      "pattern": "^\\d{4}/\\d{2}/\\d{2}\\s+[A-Z][^\\n]*?(-?[\\d,]+\\.\\d{2})\\s+(-?[\\d,]+\\.\\d{2})\\s+(-?[\\d,]+\\.\\d{2})\\s*$",
      "type": "money",
      "required": false
    },
    {
      "fields": [
        "rates_ex_r",
        "rates_vat_r",
        "rates_inc_r"
      ],
