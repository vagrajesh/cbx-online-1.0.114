      "label": "Electricity (ex VAT, summed)",
      "scope": "section:electricity",
      "collect": "sum",
      "pattern": "(?:(?:ELECTRICITY|INTERIM)\\s+[\\d,]+\\.\\d{3}\\s+kwh|BASIC ELECTRIC[A-Z ]*)\\s+(-?[\\d,]+\\.\\d{2})\\s+-?[\\d,]+\\.\\d{2}\\s+-?[\\d,]+\\.\\d{2}\\s*$",
      "type": "money",
      "required": false
    },
    {
      "field": "account_number",
      "label": "Account Number",
      "scope": "document",
      "pattern": "Account Number\\s+(\\d+)",
      "type": "text",
      "required": true
    },
    {
      "field": "site_name",
      "label": "Name",
      "scope": "document",
      "pattern": "Name\\s+([A-Z][A-Z ().-]+?)\\s{2,}",
      "type": "text",
      "required": true
