      "collect": "sum",
      "pattern": "^\\d{4}/\\d{2}/\\d{2}\\s+[A-Z][^\\n]*?(-?[\\d,]+\\.\\d{2})\\s+(-?[\\d,]+\\.\\d{2})\\s+(-?[\\d,]+\\.\\d{2})\\s*$",
      "type": "money",
      "required": false
    },
    {
      "field": "em_kwh",
      "label": "kWh (sum of kwh lines)",
      "scope": "section:electricity",
      "collect": "sum",
      "pattern": "(?:ELECTRICITY|INTERIM)\\s+([\\d ,.]+?)\\s*kwh",
      "type": "number",
      "required": false
    },
    {
      "field": "em_meter",
      "label": "Meter number(s)",
      "scope": "section:electricity",
      "collect": "join_unique",
      "pattern": "METER-NO:\\s*(\\S+)\\s+TARIFF: ELEC",
      "type": "text",
      "required": false
    },
    {
      "fields": [
        "em_end_read",
        "em_start_read"
      ],
      "label": "Curr/Prev reading (first non-KVA meter)",
      "scope": "section:electricity",
      "pattern": "METER-NO:\\s*\\S+\\s+TARIFF: ELEC(?:(?!KVA)[^\\n])*\\n\\s*Curr = ([\\d.]+) Prev = ([\\d.]+)",
      "type": "number",
      "required": false
    },
    {
      "fields": [
        "em_read_end",
        "em_read_start"
      ],
      "label": "Reading dates (Curr/Prev)",
      "scope": "section:electricity",
      "pattern": "Reading dates: Curr (\\d{4}/\\d{2}/\\d{2}) Prev (\\d{4}/\\d{2}/\\d{2})",
      "type": "text",
      "required": false
    },
    {
      "field": "em_demand_kva",
      "label": "Demand (D-meter Cons)",
      "scope": "section:electricity",
      "collect": "sum",
      "pattern": "METER-NO:\\s*D\\S+\\s+TARIFF: ELEC[^\\n]*\\n\\s*Curr = [\\d.]+ Prev = [\\d.]+ Cons = ([\\d.]+)",
      "type": "number",
      "required": false
    },
    {
      "field": "em_tariff",
      "label": "Tariff (S-meter)",
      "scope": "section:electricity",
      "pattern": "METER-NO:\\s*S\\S+\\s+TARIFF:\\s*(ELEC[^\\n(]{3,60}?)\\s*(?:\\(|$)",
      "type": "text",
      "required": false
    }
  ],
  "computes": [
    {
      "field": "em_kwh_out",
      "op": "sub",
      "as": "number",
      "of": [
        "em_kwh",
        "em_demand_kva"
      ]
    },
    {
      "field": "em_elec_ex_r",
      "op": "prefer",
      "of": [
        "em_elec_ex_r",
        "elec_ex_r"
      ]
    }
  ],
  "canonical": {
    "meter": "em_meter",
    "read_start": "em_read_start",
    "read_end": "em_read_end",
    "start_reading_kwh": "em_start_read",
    "end_reading_kwh": "em_end_read",
    "demand_kva": "em_demand_kva",
    "total_kwh": "em_kwh_out",
    "site_name": "site_name",
    "tariff_name": "em_tariff",
    "reading_type": "_none",
    "other_r": "em_elec_ex_r",
    "total_ex_vat_r": "em_elec_ex_r"
  },
  "recon": {
    "prev_balance": "BALANCE BROUGHT FORWARD\\s+([\\d,]+\\.\\d{2})",
    "subtotal": "SUB TOTAL\\s+(-?[\\d,]+\\.\\d{2})",
    "current_ex": "TOTAL CURRENT LEVY\\s+([\\d,]+\\.\\d{2})",
    "due_date": "Due Date\\s+(\\d{4}/\\d{2}/\\d{2})"
  }
