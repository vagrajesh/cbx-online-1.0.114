   "label": "Electricity Cons@ (kWh, VAT, amount)",
   "scope": "section:electricity",
   "pattern": "^[ \\t]*Electricity Cons@[^\\n]*?[ \\t]{2,}(\\d+)[ \\t]+(\\d+\\.\\d{2}-?)[ \\t]+(\\d+\\.\\d{2}-?)[ \\t]*$",
   "types": [
    "number",
