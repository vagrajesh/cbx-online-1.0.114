   "label": "Electricity Basic",
   "scope": "section:electricity",
   "pattern": "^[ \\t]*Electricity Basic[ \\t]+(\\d+\\.\\d{5})[ \\t]+(\\d+\\.\\d{2}-?)[ \\t]+(\\d+\\.\\d{2}-?)[ \\t]*$",
   "type": "money",
   "collect": "sum",
   "required": false
  },
  {
   "fields": [
    "kg_kwh",
    "kg_energy_vat",
    "kg_energy_amt"
