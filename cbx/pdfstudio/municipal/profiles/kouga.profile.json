   "pattern": "^[ \\t]*E[ \\t]+(\\d{4,})[ \\t]+(\\d+)[ \\t]+(\\d+)(?:[ \\t]+([AE]))?[ \\t]+(?:(\\d+\\.\\d{3})[ \\t]+)?(\\d{2}/\\d{2})-(\\d{2}/\\d{2})",
   "types": [
    "text",
