    "pha_kwh_vat_r"
   ]
  },
  {
   "field": "pha_kva_ex_r",
   "op": "sub",
   "of": [
    "pha_kva_inc_r",
    "pha_kva_vat_r"
   ]
  },
  {
   "field": "pha_basic_ex_r",
   "op": "sub",
   "of": [
