    "pha_basic_vat_sum_r"
   ]
  },
  {
   "field": "pha_elec_ex_r",
   "op": "sum",
   "of": [
    "pha_kwh_ex_r",
    "pha_kva_ex_r",
    "pha_basic_ex_r"
   ]
  },
  {
   "field": "pha_check_stmt_r",
   "op": "sub",
   "of": [
    "pha_amount_due_r",
    "pha_bbf_r",
    "pha_total_vat_r"
   ]
  },
  {
   "field": "pha_check_stmt_r",
   "op": "sum",
   "of": [
    "pha_check_stmt_r",
    "pha_payments_r"
   ]
  },
  {
   "field": "site_name",
   "op": "concat",
   "of": [
