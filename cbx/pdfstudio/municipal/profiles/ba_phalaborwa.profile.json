{
 "profile_id": "ba_phalaborwa",
 "profile_name": "Ba-Phalaborwa Local Municipality (Phalaborwa, Limpopo)",
 "short_name": "Ba-Phalaborwa",
 "_doc": "Munsoft-family 'TAX INVOICE / STATEMENT' with comma decimals ('9 999,99'). One page; ledger columns Date / Description / VAT / Debit / Credit / Balance. Electricity = one 'Basic Electricity <tariff> - Units n' line plus FOUR 'Electricity Consumption KWH nKWH - [from to]' register lines (no meter numbers printed), so total_kwh = sum of the registers and start/end readings are left blank (kept as text in pha_registers); flat energy mapped to standard. The 'Account Number' in the remittance block is the municipality's BANK account - the customer account is the 'Reference'. FINGERPRINT: municipal VAT number as printed + name / web domain. total_ex_vat_r = (Debit - VAT) over the electricity lines; identity pha_check_stmt_r = TOTAL AMOUNT DUE - Balance Brought Forward + payments - TOTAL VAT AMOUNT (whole-statement reconciliation from printed totals; holds because electricity is the only service billed). Checked on 5 bills (two are the same October statement).",
 "fingerprint": {
  "all": [
   "4330102841"
  ],
  "any": [
   "Ba-Phalaborwa Local Municipality",
   "phalaborwa.gov.za"
  ],
  "reject_if_text": []
 },
 "sections": {
  "electricity": {
   "start": "^[ \\t]*\\d{2}/\\d{2}/\\d{4}[ \\t]+(?:Basic Electricity|Electricity Consumption)",
   "require": "Electricity Consumption KWH"
  }
 },
 "fields": [
  {
   "field": "account_number",
   "label": "Account reference",
   "scope": "document",
   "patterns": [
    "Reference[ \\t]*:[ \\t]+(\\d{6,})",
    "^[ \\t]{10,}(\\d{9,})[ \\t]+\\d+[ \\t]+Diverse Debit"
   ],
   "type": "text",
   "required": true
  },
  {
   "field": "pha_invoice_no",
   "label": "Invoice Number",
   "scope": "document",
   "pattern": "Invoice Number\\.?:[ \\t]*(INV[ \\t]+\\d+)",
   "type": "text"
  },
  {
   "field": "billing_date",
   "label": "Statement Date",
   "scope": "document",
   "pattern": "Statement Date:[ \\t]+(\\d{4}/\\d{2}/\\d{2})",
   "type": "date",
   "required": true
  },
  {
   "field": "pha_due_date",
   "label": "Due Date",
   "scope": "document",
   "pattern": "^VAT NO:[ \\t]+(\\d{4}/\\d{2}/\\d{2})[ \\t]+Due Date",
   "type": "date"
  },
  {
   "field": "pha_month",
   "label": "Month",
   "scope": "document",
   "pattern": "Month:[ \\t]+([A-Za-z]+)[ \\t]*$",
   "type": "text"
  },
  {
   "fields": [
    "pha_stand",
    "pha_deposit_txt",
    "pha_town",
    "pha_category"
   ],
   "types": [
    "text",
    "text",
    "text",
    "text"
   ],
   "label": "Stand / Deposit / Town / Category row",
   "scope": "document",
   "pattern": "Stand Number[^\\n]*Category[ \\t]*\\n(?:[ \\t]*\\n)?[ \\t]*(\\d+[ \\t]+Portion[ \\t]+\\d+)[ \\t]{2,}(-?[\\d ]*,\\d{2})[ \\t]{2,}[\\d ]*,\\d{2}[ \\t]{2,}(\\S[^\\n]*?)[ \\t]{2,}([A-Z][A-Z ]*?)[ \\t]*$"
  },
  {
   "field": "deposit_r",
   "label": "Deposit",
   "scope": "document",
   "pattern": "Stand Number[^\\n]*Category[ \\t]*\\n(?:[ \\t]*\\n)?[ \\t]*\\d+[ \\t]+Portion[ \\t]+\\d+[ \\t]{2,}((?<![\\d,])-?\\d{1,3}(?:[ ]\\d{3})*,\\d{2})(?![\\d])",
   "type": "money"
  },
  {
   "field": "pha_bbf_r",
   "label": "Balance Brought Forward",
   "scope": "document",
   "pattern": "Balance Brought Forward[ \\t]{2,}((?<![\\d,])-?\\d{1,3}(?:[ ]\\d{3})*,\\d{2})(?![\\d])[ \\t]*$",
   "type": "money"
  },
  {
   "field": "pha_payments_r",
   "label": "Payments (credit column, sum)",
   "scope": "document",
   "collect": "sum",
   "pattern": "^[ \\t]*\\d{2}/\\d{2}/\\d{4}[ \\t]+[^\\n]*PAYMENT[^\\n]*?[ \\t]{2,}-?[\\d ]*,\\d{2}[ \\t]{2,}((?<![\\d,])-?\\d{1,3}(?:[ ]\\d{3})*,\\d{2})(?![\\d])[ \\t]{2,}-?[\\d ]*,\\d{2}[ \\t]*$",
   "type": "money"
  },
  {
   "field": "pha_total_vat_r",
   "label": "TOTAL VAT AMOUNT",
   "scope": "document",
   "pattern": "TOTAL VAT AMOUNT[ \\t]{2,}((?<![\\d,])-?\\d{1,3}(?:[ ]\\d{3})*,\\d{2})(?![\\d])",
   "type": "money"
  },
  {
   "field": "pha_amount_due_r",
   "label": "TOTAL AMOUNT DUE",
   "scope": "document",
   "pattern": "TOTAL AMOUNT DUE[ \\t]{2,}((?<![\\d,])-?\\d{1,3}(?:[ ]\\d{3})*,\\d{2})(?![\\d])",
   "type": "money"
  },
  {
   "fields": [
    "tariff_name",
    "pha_basic_vat_r",
    "pha_basic_inc_r"
   ],
   "types": [
    "text",
    "money",
    "money"
   ],
   "label": "Basic Electricity line",
   "scope": "section:electricity",
   "pattern": "^[ \\t]*\\d{2}/\\d{2}/\\d{4}[ \\t]+Basic Electricity[ \\t]+([A-Za-z][A-Za-z ]*?)[ \\t]+-[ \\t]+Units[^\\n]*?[ \\t]{2,}((?<![\\d,])-?\\d{1,3}(?:[ ]\\d{3})*,\\d{2})(?![\\d])[ \\t]{2,}((?<![\\d,])-?\\d{1,3}(?:[ ]\\d{3})*,\\d{2})(?![\\d])[ \\t]{2,}-?[\\d ]*,\\d{2}[ \\t]*$",
   "required": true
  },
  {
   "fields": [
    "pha_basic_vat_sum_r",
    "pha_basic_inc_sum_r"
   ],
   "types": [
    "money",
    "money"
   ],
   "label": "Basic Electricity lines (sum)",
   "scope": "section:electricity",
   "collect": "sum",
   "pattern": "^[ \\t]*\\d{2}/\\d{2}/\\d{4}[ \\t]+Basic Electricity[^\\n]*?[ \\t]{2,}((?<![\\d,])-?\\d{1,3}(?:[ ]\\d{3})*,\\d{2})(?![\\d])[ \\t]{2,}((?<![\\d,])-?\\d{1,3}(?:[ ]\\d{3})*,\\d{2})(?![\\d])[ \\t]{2,}-?[\\d ]*,\\d{2}[ \\t]*$"
  },
  {
   "fields": [
    "pha_kwh",
    "pha_kwh_vat_r",
    "pha_kwh_inc_r"
   ],
   "types": [
    "number",
    "money",
    "money"
   ],
   "label": "Electricity Consumption KWH lines (sum over registers)",
   "scope": "section:electricity",
   "collect": "sum",
   "pattern": "^[ \\t]*\\d{2}/\\d{2}/\\d{4}[ \\t]+Electricity Consumption KWH[ \\t]+(\\d+(?:\\.\\d+)?)KWH[ \\t]*-[ \\t]*\\[[^\\]\\n]*\\][ \\t]{2,}((?<![\\d,])-?\\d{1,3}(?:[ ]\\d{3})*,\\d{2})(?![\\d])[ \\t]{2,}((?<![\\d,])-?\\d{1,3}(?:[ ]\\d{3})*,\\d{2})(?![\\d])[ \\t]{2,}-?[\\d ]*,\\d{2}[ \\t]*$",
   "required": true
  },
  {
   "field": "pha_registers",
   "label": "Readings per register as printed",
   "scope": "section:electricity",
   "collect": "join_unique",
   "pattern": "Electricity Consumption KWH[ \\t]+\\d+(?:\\.\\d+)?KWH[ \\t]*-[ \\t]*(\\[[^\\]\\n]*\\])",
   "type": "text"
  },
  {
   "fields": [
    "pha_kva_vat_r",
    "pha_kva_inc_r"
   ],
   "types": [
    "money",
    "money"
   ],
   "label": "Electricity Consumption KVA lines (sum)",
   "scope": "section:electricity",
   "collect": "sum",
   "pattern": "^[ \\t]*\\d{2}/\\d{2}/\\d{4}[ \\t]+Electricity Consumption KVA[^\\n]*?[ \\t]{2,}((?<![\\d,])-?\\d{1,3}(?:[ ]\\d{3})*,\\d{2})(?![\\d])[ \\t]{2,}((?<![\\d,])-?\\d{1,3}(?:[ ]\\d{3})*,\\d{2})(?![\\d])[ \\t]{2,}-?[\\d ]*,\\d{2}[ \\t]*$"
  }
 ],
 "computes": [
