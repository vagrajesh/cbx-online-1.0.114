   "pattern": "^[ \\t]*Electricity Metered[ \\t]{2,}(\\(?R[ \\t]*-?[\\d ]+\\.\\d{2}\\)?|-)[ \\t]{2,}(\\(?R[ \\t]*-?[\\d ]+\\.\\d{2}\\)?|-)[ \\t]{2,}(\\(?R[ \\t]*-?[\\d ]+\\.\\d{2}\\)?|-)[ \\t]*$"
