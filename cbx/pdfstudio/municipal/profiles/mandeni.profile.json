    "money",
    "text"
   ],
   "label": "Energy detail row (print B: meter on next line)",
   "scope": "section:electricity",
   "pattern": "^[ \\t]+(\\d\\d-\\d\\d-\\d{4})[ \\t]+(\\d\\d-\\d\\d-\\d{4})[ \\t][^\\n]*?[\\d.]+KW - \\[(?!0 to)[\\d.]+ to [\\d.]+\\][ \\t]+(?:Actual|Estimated?|Average|Interim)[ \\t]+(-?(?:\\d{1,3}(?:,\\d{3})+|\\d*)\\.\\d{2}-?)[ \\t]*\\n[ \\t]*(E\\d+-\\w+)[ \\t]"
