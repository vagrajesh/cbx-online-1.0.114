   ],
   "label": "Energy readings [start to end]",
   "scope": "section:electricity",
   "pattern": "^[ \\t]*\\d\\d/\\d\\d/\\d{4}[ \\t]+Electricity Consumption[ \\t]+[\\d.]+KW[ \\t]*-[ \\t]*\\[(?!0 to)([\\d.]+) to ([\\d.]+)\\]"
  },
  {
   "fields": [
    "meter",
    "read_start",
    "read_end",
    "md_kwh_excl_r"
   ],
   "types": [
    "text",
    "date",
    "date",
    "money"
   ],
   "label": "Energy detail row (print A: meter first)",
   "scope": "section:electricity",
   "pattern": "^[ \\t]*(E\\d+-\\w+)[ \\t]+(\\d\\d/\\d\\d/\\d{4})[ \\t]+(\\d\\d/\\d\\d/\\d{4})[ \\t]+\\d+[ \\t]+[^\\n]*?[\\d.]+KW - \\[(?!0 to)[\\d.]+ to [\\d.]+\\][ \\t]+(-?(?:\\d{1,3}(?:,\\d{3})+|\\d*)\\.\\d{2}-?)[ \\t]*$"
