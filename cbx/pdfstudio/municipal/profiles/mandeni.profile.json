   "scope": "section:electricity",
   "collect": "sum",
   "patterns": [
    "^[ \\t]*E\\d+-\\w+[ \\t]+\\d\\d/\\d\\d/\\d{4}[ \\t]+\\d\\d/\\d\\d/\\d{4}[ \\t]+\\d+[ \\t]+[^\\n]*?[\\d.]+KW - \\[0 to [\\d.]+\\][ \\t]+(-?(?:\\d{1,3}(?:,\\d{3})+|\\d*)\\.\\d{2}-?)[ \\t]*$",
    "^[ \\t]+\\d\\d-\\d\\d-\\d{4}[ \\t]+\\d\\d-\\d\\d-\\d{4}[ \\t][^\\n]*?[\\d.]+KW - \\[0 to [\\d.]+\\][ \\t]+(?:Actual|Estimated?|Average|Interim)[ \\t]+(-?(?:\\d{1,3}(?:,\\d{3})+|\\d*)\\.\\d{2}-?)[ \\t]*$"
