{
 "profile_id": "dr_beyers_naude",
 "profile_name": "Dr Beyers Naude Local Municipality (Graaff-Reinet, Eastern Cape)",
 "short_name": "Dr Beyers Naude",
 "_doc": "Pre-printed-stationery statement (same print engine as the Oudtshoorn/Knysna 'TAR:' ledgers, English labels): the masthead carries only the account number (nn-nnnnnnnnn) and the site street, no municipal name; the only 'VAT Registration number' printed is the CUSTOMER's, so it is NOT used. Fingerprint = the layout's own strings 'ELECTRICITY CONSUMPTION (' + 'TAR:' + 'BALANCE BROUGHT FORWARD' + 'TOTAL VAT:' (unique to this folder in the corpus) with reject markers for the sibling billers on the same engine (Oudtshoorn, Knysna, Sundays River, Swartland, Laingsburg, 'TOTALE BTW'). Ledger: 'dd/mm/yy code DESCRIPTION  VAT  AMOUNT(incl)' with a detail block per metered line: the kWh line (code = meter number) prints 'new - old = n KWH d DAYS', 'units KWH @ rate = Rands' and 'TAR:code BASIC: = Rands'; the demand line (meter+K) prints 'n KVA @ rate = Rands'; water likewise in Kl. total_ex_vat_r = energy + basic + demand from the detail lines; standard = the single energy band, other_r = BASIC, demand from the KVA line. billing_date = the electricity line date (dd/mm/yy as printed), read period from the line's (start-end). IDENTITY dbn_ledger_ex_r = the electricity ledger lines' AMOUNT column minus their VAT column (printed independently of the detail calculations): exact on 10/10. 10/10 bills routed, 0 checks. No deposit/estimate flag is labelled on the print, so those stay blank. A water row is produced too.",
 "fingerprint": {
  "all": [
   "ELECTRICITY CONSUMPTION (",
   "TAR:",
   "BALANCE BROUGHT FORWARD",
   "TOTAL VAT:"
  ],
  "any": [],
  "reject_if_text": [
   "OUDTSHOORN",
   "KNYSNA",
   "SUNDAYS RIVER",
   "SWARTLAND",
   "LAINGSBURG",
   "TOTALE BTW"
  ]
 },
 "sections": {
  "electricity": {
   "start": "^[ \\t]*\\d{2}/\\d{2}/\\d{2}[ \\t]+\\S+[ \\t]+ELECTRICITY CONSUMPTION\\b"
  },
  "water": {
   "start": "^[ \\t]*\\d{2}/\\d{2}/\\d{2}[ \\t]+\\S+[ \\t]+WATER CONSUMPTION\\b"
  },
  "sundry": {
   "start": "^[ \\t]*(?:RATES NOTICE|VAT Registration number)\\b"
  }
 },
 "fields": [
  {
   "field": "account_number",
   "label": "Account number (masthead, printed nn-nnnnnnnnn)",
   "scope": "header",
   "pattern": "\\A\\s*(\\d{2}-\\d{9})[ \\t]*$",
   "type": "text",
   "required": true
  },
  {
   "field": "dbn_reference",
   "label": "Payment reference",
   "scope": "document",
   "pattern": "REFERENCE:[ \\t]+(\\d{8,})",
   "type": "text"
  },
  {
   "field": "billing_date",
   "label": "Electricity charge date (statement date)",
   "scope": "section:electricity",
   "pattern": "^[ \\t]*(\\d{2}/\\d{2}/\\d{2})[ \\t]+\\S+[ \\t]+ELECTRICITY CONSUMPTION\\b",
   "type": "date",
   "required": true
  },
  {
   "field": "dbn_site",
   "label": "Site street (masthead)",
   "scope": "header",
   "pattern": "^[ \\t]*\\d+[ \\t]+(\\d+[ \\t]+[A-Z][A-Z ]*?STREET)[ \\t]*$",
   "type": "text"
  },
  {
   "field": "meter",
   "label": "Electricity meter (kWh line code)",
   "scope": "section:electricity",
   "pattern": "^[ \\t]*\\d{2}/\\d{2}/\\d{2}[ \\t]+(\\d+)[ \\t]+ELECTRICITY CONSUMPTION\\b",
   "type": "text",
   "required": true
  },
  {
   "fields": [
    "read_start",
    "read_end"
   ],
   "types": [
    "date",
    "date"
   ],
   "label": "Reading period",
   "scope": "section:electricity",
   "pattern": "^[ \\t]*\\d{2}/\\d{2}/\\d{2}[ \\t]+\\d+[ \\t]+ELECTRICITY CONSUMPTION \\((\\d{2}/\\d{2}/\\d{4})-(\\d{2}/\\d{2}/\\d{4})\\)",
   "required": true
  },
  {
   "fields": [
    "end_reading_kwh",
    "start_reading_kwh",
    "dbn_reading_kwh"
   ],
   "types": [
    "number",
    "number",
    "number"
   ],
   "label": "kWh register (new - old = units KWH)",
   "scope": "section:electricity",
   "pattern": "^[ \\t]*(\\d+)[ \\t]+-[ \\t]+(\\d+)[ \\t]+=[ \\t]+(\\d+)[ \\t]+KWH\\b",
   "required": true
  },
  {
   "fields": [
    "dbn_kwh",
    "dbn_energy_r"
   ],
   "types": [
    "number",
    "money"
   ],
   "label": "Energy (units KWH @ rate = Rands), all steps",
   "scope": "section:electricity",
   "collect": "sum",
   "pattern": "(\\d+(?:\\.\\d+)?)[ \\t]+KWH[ \\t]+@[ \\t]+[\\d.]+[ \\t]+=[ \\t]+(-?\\d+\\.\\d{2})[ \\t]*$",
   "required": true
  },
  {
   "field": "dbn_basic_r",
   "label": "Electricity BASIC charge",
   "scope": "section:electricity",
   "collect": "sum",
   "pattern": "^[ \\t]*TAR:[ \\t]*\\d+[ \\t]+BASIC:[ \\t]+=[ \\t]+(-?\\d+\\.\\d{2})[ \\t]*$",
   "type": "money"
  },
  {
   "fields": [
    "dbn_demand_kva",
    "dbn_demand_r"
   ],
   "types": [
    "number",
    "money"
   ],
   "label": "Demand (units KVA @ rate = Rands)",
   "scope": "section:electricity",
   "collect": "sum",
   "pattern": "(\\d+(?:\\.\\d+)?)[ \\t]+KVA[ \\t]+@[ \\t]+[\\d.]+[ \\t]+=[ \\t]+(-?\\d+\\.\\d{2})[ \\t]*$"
  },
  {
   "field": "dbn_tariff",
   "label": "Electricity tariff code (kWh line)",
   "scope": "section:electricity",
   "pattern": "^[ \\t]*TAR:[ \\t]*(\\d+)[ \\t]+BASIC:",
   "type": "text"
  },
  {
   "fields": [
    "dbn_elec_vat_r",
    "dbn_elec_incl_r"
   ],
   "types": [
    "money",
    "money"
   ],
   "label": "Electricity ledger lines: VAT and AMOUNT columns",
   "scope": "section:electricity",
   "collect": "sum",
   "pattern": "^[ \\t]*\\d{2}/\\d{2}/\\d{2}[ \\t]+\\S+[ \\t]+ELECTRICITY CONSUMPTION[^\\n]*?[ \\t]{2,}(-?\\d{1,3}(?: \\d{3})*\\.\\d{2})[ \\t]{2,}(-?\\d{1,3}(?: \\d{3})*\\.\\d{2})[ \\t]*$",
   "required": true
  },
  {
   "field": "dbn_total_vat_r",
   "label": "TOTAL VAT",
   "scope": "document",
   "pattern": "TOTAL VAT:[ \\t]+(-?\\d{1,3}(?: \\d{3})*\\.\\d{2})",
   "type": "money"
  },
  {
   "field": "meter",
   "label": "Water meter",
   "scope": "section:water",
   "pattern": "^[ \\t]*\\d{2}/\\d{2}/\\d{2}[ \\t]+(\\d+)[ \\t]+WATER CONSUMPTION\\b",
   "type": "text"
  },
  {
   "fields": [
    "read_start",
    "read_end"
   ],
   "types": [
    "date",
    "date"
   ],
   "label": "Water reading period",
   "scope": "section:water",
   "pattern": "^[ \\t]*\\d{2}/\\d{2}/\\d{2}[ \\t]+\\d+[ \\t]+WATER CONSUMPTION \\((\\d{2}/\\d{2}/\\d{4})-(\\d{2}/\\d{2}/\\d{4})\\)"
  },
  {
   "fields": [
    "dbn_water_end",
    "dbn_water_start",
    "dbn_water_kl"
   ],
   "types": [
    "number",
    "number",
    "number"
   ],
   "label": "Water register (new - old = Kl)",
   "scope": "section:water",
   "pattern": "^[ \\t]*(\\d+)[ \\t]+-[ \\t]+(\\d+)[ \\t]+=[ \\t]+(\\d+)[ \\t]+Kl\\b"
  },
  {
   "fields": [
    "dbn_water_vat_r",
    "dbn_water_incl_r"
   ],
   "types": [
    "money",
    "money"
   ],
   "label": "Water ledger line: VAT and AMOUNT",
   "scope": "section:water",
   "pattern": "^[ \\t]*\\d{2}/\\d{2}/\\d{2}[ \\t]+\\S+[ \\t]+WATER CONSUMPTION[^\\n]*?[ \\t]{2,}(-?\\d{1,3}(?: \\d{3})*\\.\\d{2})[ \\t]{2,}(-?\\d{1,3}(?: \\d{3})*\\.\\d{2})[ \\t]*$"
  }
 ],
 "computes": [
  {
   "field": "dbn_elec_ex_r",
   "label": "Electricity ex VAT = energy + basic + demand (detail lines)",
   "op": "sum",
   "of": [
    "dbn_energy_r",
    "dbn_basic_r",
    "dbn_demand_r"
   ]
  },
  {
   "field": "dbn_ledger_ex_r",
   "label": "IDENTITY: ledger AMOUNT - ledger VAT of the electricity lines",
   "op": "sub",
   "of": [
    "dbn_elec_incl_r",
    "dbn_elec_vat_r"
   ]
  },
  {
   "field": "dbn_water_ex_r",
   "op": "sub",
   "of": [
    "dbn_water_incl_r",
    "dbn_water_vat_r"
   ]
  }
 ],
 "canonical": {
  "site_name": "dbn_site",
  "billing_date": "billing_date",
  "tariff_name": "dbn_tariff",
  "account_number": "account_number",
  "meter": "meter",
  "reading_type": "_none",
