{
 "profile_id": "eskom",
 "profile_name": "Eskom",
 "short_name": "Eskom",
 "_doc": "Eskom large-power TOU. Dates YYYY-MM-DD. Reads from page 2 (linear); page 1 is column-scrambled by the PDF and ignored. Total energy kWh = STD line; Energy Rands = High+Low season summed. Demand kVA = Demand Reading. Other Charges computed. | CBX 1.0.78: reject 'PHUMELELA LOCAL MUNICIPALITY' — Phumelela municipal bills print 'ESKOM' and were taken as Eskom bills (Telkom folder, Oct 2026).",
 "fingerprint": {
  "all": [
   "ESKOM"
  ],
  "any": [
   "ESKOM HOLDINGS",
   "WWW.ESKOM.CO.ZA",
   "TARIFF NAME",
   "TOTAL CHARGES FOR BILLING PERIOD"
  ],
  "reject_if_text": [
   "MALUTI - A - PHOFUNG",
   "PHUMELELA LOCAL MUNICIPALITY"
  ]
 },
