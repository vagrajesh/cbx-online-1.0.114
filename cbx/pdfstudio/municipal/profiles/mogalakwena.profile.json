   "require": "^[ \\t]*(?:\\d{2}/\\d{2}/\\d{4}[ \\t]+)?\\w{6}[ \\t]+(?=\\S)(?:(?!INTEREST)[^\\n]*?ELECTRICITY)[^\\n]*?[ \\t]{2,}(-?[\\d,]*\\.\\d{2}-?)[ \\t]*$"
  },
  "sundry": {
   "start": "^[ \\t]*REMITTANCE ADVICE\\b"
  }
 },
