  {
   "field": "site_name",
   "op": "concat",
   "of": [
    "moq_desc",
    "moq_suburb"
   ]
  },
  {
   "field": "moq_water_r",
   "op": "mul",
   "of": [
    "moq_water_kl",
    "moq_water_tariff"
   ]
  },
  {
   "field": "moq_elec_metered_r",
   "op": "sub",
   "of": [
    "moq_metered_r",
    "moq_water_r"
   ]
  },
  {
   "field": "moq_elec_ex_r",
   "op": "sum",
   "of": [
    "moq_elec_metered_r",
    "moq_be_r"
   ]
  },
  {
   "field": "moq_elec_check_r",
   "op": "sub",
   "of": [
    "moq_total_month_r",
    "moq_row2_r",
    "moq_row3_r",
    "moq_rates_r",
    "moq_bs_r",
    "moq_in_r",
    "moq_water_r"
   ]
  }
 ],
