   "pattern": "^[ \\t]*\\d{2}/\\d{2}[ \\t]+(?!Electricity)[A-Za-z][^\\n]*?[ \\t]{2,}(-?\\d+\\.\\d{2}-?)[ \\t]+(-?\\d+\\.\\d{2}-?)[ \\t]+(-?\\d+\\.\\d{2}-?)[ \\t]*$"
  },
  {
