{
 "profile_id": "umlalazi",
 "profile_name": "uMlalazi Local Municipality (Eshowe, KwaZulu-Natal)",
 "short_name": "uMlalazi",
 "_doc": "uMlalazi Local Municipality (Eshowe) 'TAX INVOICE / STATEMENT': header with ACCOUNT NUMBER / TAX INVOICE / 'VAT REG. No.: 4170193181' (the municipality's own) / INVOICE DATE / MONTH, street/stand, deposit, a METER READINGS table (K<meter> kWh register and E<meter> kVA register rows: old | new | consumption | 'dd/mm-dd/mm'), an ACCOUNT DETAILS ledger (DATE dd/mm | DESCRIPTION | BASIC (ex VAT) | VAT | AMOUNT) whose 'Electricity' lines are the energy line (followed by '0+kWh @ R<rate>' steps), the demand line (followed by '0+KVA @ R<rate>'), a fixed line with no step, and occasional 'Electricity Journal' adjustments, then Refuse/Rates/Interest, '** Total Monthly', and an aging strip with a VAT column. total_ex_vat_r = sum of the BASIC column of all Electricity lines (journals included, interest excluded); standard_r = energy line, demand_r = kVA line, other_r = the rest (fixed + journals). kWh, readings and meter from the K row, demand_kva from the E row (kWh x printed rate = energy line within 1c on all text bills). Fingerprint: 'Total Monthly' plus any of VAT 4170193181 / 'uMlalazi' / the bill's own footer 'BALANCE BROUGHT FORWARD NOW OVERDUE AND SUBJECT TO DISCONNECTION' (the two 'MAY 2026 STATEMENT' files are header-less: only the ledger and that footer survive, so they have no account number or date). IDENTITY uml_ident_ex = electricity AMOUNT column - (aging-strip VAT - non-electricity VAT): 0.00 on 6/6 bills that print the strip; not computable on the 2 header-less files. The two OCR scans (June and August 2026) are deliberately given no electricity row: the section requires text free of OCR '|' artefacts, because their digits are misread (e.g. a 1107.31 line reads 1167.31) and a partial total would be wrong. 10 files: 10 routed, 8 electricity rows.",
 "fingerprint": {
  "all": [
   "Total Monthly"
  ],
  "any": [
   "4170193181",
   "uMlalazi",
   "BALANCE BROUGHT FORWARD NOW OVERDUE AND SUBJECT TO DISCONNECTION"
  ],
  "reject_if_text": []
 },
 "sections": {
  "electricity": {
   "start": "^[ \\t]*Balance brought forward:",
   "require": "\\A(?![\\s\\S]*\\|)[\\s\\S]*?^[ \\t]*\\d{2}/\\d{2}[ \\t]+Electricity\\b"
  },
  "sundry": {
   "start": "\\*\\*[ \\t]*Total Monthly:"
  }
 },
 "fields": [
  {
   "field": "account_number",
   "label": "Account number",
   "scope": "document",
   "pattern": "ACCOUNT NUMBER:[ \\t;:]+(\\d{7,})\\b",
   "type": "text",
   "required": true
  },
  {
   "field": "billing_date",
   "label": "Invoice date",
   "scope": "document",
   "patterns": [
    "INVOICE DATE:[ \\t]+(\\d{2}/\\d{2}/\\d{4})",
    "VAT REG\\. No\\.:[ \\t]*\\d{10}[ \\t]+(\\d{2}/\\d{2}/\\d{4})"
   ],
   "type": "date",
   "required": true
  },
  {
   "field": "uml_month",
   "label": "Month",
   "scope": "document",
   "pattern": "MONTH:[ \\t]+(\\d{4}/\\d{2})",
   "type": "text"
  },
  {
   "field": "uml_tax_invoice",
   "label": "Tax invoice no",
   "scope": "document",
   "pattern": "TAX INVOICE :[ \\t]+(\\d{6,})",
   "type": "text"
  },
  {
   "field": "site_name",
   "label": "Street address / stand",
   "scope": "document",
   "pattern": "STREET ADDRESS/ STAND[^\\n]*\\n[ \\t]*([A-Z][A-Z0-9 ]*?[A-Z0-9])(?:[ \\t]{2,}|[ \\t]*$)",
   "type": "text"
  },
  {
   "field": "deposit_r",
