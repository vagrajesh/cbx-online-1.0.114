   "collect": "sum",
   "pattern": "^[ \\t]*\\d{2}/\\d{2}[ \\t]+Electricity\\b[^\\n]*?[ \\t]{2,}(-?\\d+\\.\\d{2}-?)[ \\t]+(-?\\d+\\.\\d{2}-?)[ \\t]+(-?\\d+\\.\\d{2}-?)[ \\t]*$",
   "required": true
