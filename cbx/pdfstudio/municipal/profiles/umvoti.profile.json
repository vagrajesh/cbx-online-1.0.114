   "type": "date",
   "required": true
  },
  {
   "field": "umv_month",
   "label": "Month (first billed month)",
   "scope": "document",
   "pattern": "Month:[ \\t]+([A-Za-z]+[ \\t]+\\d{4})",
   "type": "text"
  },
  {
   "field": "umv_due_date",
   "label": "Due Date",
   "scope": "document",
   "pattern": "Due Date:[ \\t]+(\\d{1,2}[ \\t]+[A-Za-z]+[ \\t]+\\d{4})",
   "type": "date"
  },
  {
   "field": "umv_invoice_no",
   "label": "Invoice No",
   "scope": "document",
   "pattern": "Invoice No\\.:[ \\t]+(\\d+[ \\t]+\\d+)",
