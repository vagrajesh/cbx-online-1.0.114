 "computes": [
  {
   "field": "umv_rate",
   "op": "concat",
   "of": [
    "umv_rate_int",
    "umv_dot",
    "umv_rate_frac"
   ]
  },
  {
   "field": "umv_energy_ex",
   "op": "mul",
   "of": [
    "umv_kwh",
    "umv_rate"
   ]
  },
  {
   "field": "umv_demand_ex",
   "op": "mul",
   "of": [
    "umv_kva_sum",
    "umv_kva_rate"
   ]
  },
  {
   "field": "umv_elec_ex",
   "op": "sum",
   "of": [
    "umv_basic_ex",
    "umv_energy_ex",
    "umv_demand_ex"
   ]
  },
  {
   "field": "umv_elec_incl",
   "op": "sum",
   "of": [
    "umv_basic_incl",
    "umv_energy_incl",
    "umv_demand_incl"
   ]
  },
  {
   "field": "umv_refuse_vat",
   "op": "sub",
   "of": [
    "umv_refuse_incl",
    "umv_refuse_ex"
   ]
  },
  {
   "field": "umv_elec_vat_strip",
   "op": "sub",
   "of": [
    "umv_vat_total",
    "umv_refuse_vat"
   ]
  },
  {
   "field": "umv_ident_ex",
   "op": "diff",
   "of": [
    "umv_elec_vat_strip",
    "umv_elec_incl"
   ]
  }
 ],
