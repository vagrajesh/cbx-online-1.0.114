   "pattern": "(?:^|\\s{2,})Elec:\\d+[ \\t]+Cons (?:New|Old)[ \\t]+([\\d.]+)[ \\t]+(?:[\\d.]+[ \\t]+)?(?:\\d+\\.\\d{2}(?=\\d))?(\\d+\\.\\d{2})[ \\t]+(\\d[\\d,]*\\.\\d{2})(?=\\s{2,}\\D|[ \\t]*$)",
   "collect": "sum",
   "required": false
