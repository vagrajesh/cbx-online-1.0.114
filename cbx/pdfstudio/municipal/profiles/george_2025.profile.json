    "money"
   ],
   "label": "Off-peak energy",
   "scope": "section:electricity",
   "pattern": "(?:^|\\s{2,})Off Peak(?: Ener\\w*)?[ \\t]+TOUOS[ \\t]+([\\d.]+)[ \\t]+(?:[\\d.]+[ \\t]+)?(?:\\d+\\.\\d{2}(?=\\d))?(\\d+\\.\\d{2})[ \\t]+(\\d[\\d,]*\\.\\d{2})(?=\\s{2,}\\D|[ \\t]*$)",
   "collect": "sum",
   "required": false
  },
  {
