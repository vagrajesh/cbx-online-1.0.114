{
 "profile_id": "george_2025",
 "profile_name": "George Municipality – 2025 ledger statement",
 "short_name": "George",
 "_doc": "George statements from before the October 2025 layout (May–September 2025 in the Telkom folder): one page of service ledger rows (BALANCE OPENING / RECEIPTS / CHARGE / … / BALANCE CLOSING), then charge lines 'Peak Energy TOUPM <kWh> <ex><incl> <VAT>' — the ex-VAT and incl-VAT amounts print GLUED together on the TOU and demand lines (e.g. 1000.002000.00) — plus 'Electricity Demand: kVa' lines and small conventional meters 'Elec:<tariff> Cons New/Old <kWh> <c/kWh> <incl> <VAT>'. Every line is read as incl and VAT and the ex-VAT is incl − VAT, which needs no guess at where the glue splits. Checked on 5 bills: the electricity lines add up, to the cent, to the bill's own electricity CHARGE row (ge_elec_charge_r). Reading periods print without a year (dd/mm-dd/mm). Built by CBX 1.0.77 from the Telkom folder. Total kWh is the TOU meter's (Peak + Standard + Off-peak); the small conventional meters' kWh stay in small_kwh and their Rands are in Other.",
 "fingerprint": {
  "all": [
   "4630193664",
   "SITE ADDRESS:",
   "BALANCECLOSING"
  ],
  "any": [
   "TOUPM",
   "Elec:",
   "Demand: kVa"
  ],
  "reject_if_text": [
   "George Municipality",
   "amptera.openaccess.energy"
  ]
 },
 "sections": {
  "electricity": {
   "start": "^\\s*SERVICE\\s+BALANCE ?OPENING"
  }
 },
 "fields": [
  {
   "field": "account_number",
   "label": "Account No.",
   "scope": "header",
   "pattern": "ACCOUNT NO\\.\\s+(GRG\\s*\\d+)",
   "type": "text",
   "required": true
  },
  {
   "field": "billing_date",
   "label": "Statement date",
   "scope": "header",
   "pattern": "STATEMENT DATE\\s+(\\d{2}/\\d{2}/\\d{4})",
   "type": "date",
   "required": true
  },
  {
   "field": "invoice_number",
   "label": "Tax invoice no.",
   "scope": "header",
   "pattern": "TAX INVOICE NO\\.\\s+(\\d+)",
