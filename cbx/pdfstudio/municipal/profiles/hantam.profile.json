{
 "profile_id": "hantam",
 "profile_name": "Hantam Local Municipality (Calvinia, Northern Cape)",
 "short_name": "Hantam",
 "_doc": "Afrikaans 'Rekeningstaat / Statement' ledger (Datum / Besonderhede / Debiet / Krediet / Saldo); amounts are EX VAT, one 'TOTALE BTW' line for the whole statement. Electricity = one 'MEER AS n AMPERE' capacity line (other_r) + one 'ELEK BESIGHEDE nAMP' line per meter (three meters on every bill; energy -> standard_r). Each ELEK line has a small box (date / TARIFF / UNITS / RAND, current, previous reading, consumption) but the three boxes interleave in the text layer (and one meter has a x5 factor), so readings / kWh cannot be paired to a meter reliably and are left BLANK (blank over wrong); no meter numbers are printed. Deposit is printed in brackets as a held amount and read as a positive value. FINGERPRINT: the municipality's BTW-nommer as printed + 'Hantam' / 'Rekeningstaat / Statement'. total_ex_vat_r = sum of ELEK lines + MEER AS line; identity han_check_r = sum of the RAND column of the meter boxes (printed independently of the ledger) + the MEER AS line. Checked on 11 bills.",
 "fingerprint": {
  "all": [
   "4860196072"
  ],
  "any": [
   "Hantam",
   "Rekeningstaat / Statement"
  ],
  "reject_if_text": []
 },
 "sections": {
  "electricity": {
   "start": "^[ \\t]*\\d{4}/\\d{2}/\\d{2}[ \\t]+(?:ELEK[ \\t]|MEER AS \\d+ AMPERE)",
   "require": "^[ \\t]*\\d{4}/\\d{2}/\\d{2}[ \\t]+ELEK[ \\t]"
  }
 },
 "fields": [
  {
   "field": "account_number",
   "label": "Rekeningnommer",
   "scope": "document",
   "pattern": "Rekeningnommer :[ \\t]+(\\d{6,})",
   "type": "text",
   "required": true
  },
  {
   "field": "billing_date",
   "label": "Rekening Datum",
   "scope": "document",
   "pattern": "Rekening Datum :[ \\t]+(\\d{4}/\\d{2}/\\d{2})",
   "type": "date",
   "required": true
  },
  {
   "field": "han_due_date",
   "label": "Vervaldatum",
   "scope": "document",
   "pattern": "Vervaldatum :[ \\t]+(\\d{4}/\\d{2}/\\d{2})",
   "type": "date"
  },
  {
   "field": "han_erf",
   "label": "Erfnommer",
   "scope": "document",
   "pattern": "Erfnommer :[ \\t]+(\\d+)",
   "type": "text"
  },
  {
   "field": "deposit_r",
   "label": "U verbruikersdeposito (R) (held, printed in brackets)",
   "scope": "document",
   "pattern": "verbruikersdeposito :[ \\t]*\\(R\\)[ \\t]*\\(?((?<![\\d.])\\d+(?: \\d{3})*\\.\\d{2})\\)?",
   "type": "money"
  },
  {
   "field": "han_total_vat_r",
   "label": "TOTALE BTW (whole statement)",
   "scope": "document",
   "pattern": "TOTALE BTW[ \\t]+((?<![\\d.,])-?\\d+(?:[ ,]\\d{3})*\\.\\d{2}-?)(?![\\d])",
   "type": "money"
  },
  {
   "field": "han_amount_due_r",
   "label": "TOTALE BEDRAG VERSKULDIG",
   "scope": "document",
   "pattern": "TOTALE BEDRAG VERSKULDIG[^\\n]*?[ \\t]{2,}((?<![\\d.,])-?\\d+(?:[ ,]\\d{3})*\\.\\d{2}-?)(?![\\d])[ \\t]*$",
   "type": "money"
  },
  {
   "field": "tariff_name",
   "label": "ELEK tariff description(s)",
   "scope": "section:electricity",
   "collect": "join_unique",
   "pattern": "^[ \\t]*\\d{4}/\\d{2}/\\d{2}[ \\t]+(ELEK[^\\n]*?)[ \\t]{2,}-?[\\d ]+\\.\\d{2}",
   "type": "text",
   "required": true
  },
  {
   "field": "han_elek_r",
   "label": "ELEK ledger lines, Debiet ex VAT (sum over meters)",
   "scope": "section:electricity",
   "collect": "sum",
   "pattern": "^[ \\t]*\\d{4}/\\d{2}/\\d{2}[ \\t]+ELEK[^\\n]*?[ \\t]{2,}((?<![\\d.,])-?\\d+(?:[ ,]\\d{3})*\\.\\d{2}-?)(?![\\d])[ \\t]{2,}((?<![\\d.,])-?\\d+(?:[ ,]\\d{3})*\\.\\d{2}-?)(?![\\d])[ \\t]*$",
   "type": "money",
   "required": true
  },
  {
   "field": "han_meer_r",
   "label": "MEER AS n AMPERE (capacity charge, ex VAT)",
   "scope": "section:electricity",
   "collect": "sum",
   "pattern": "^[ \\t]*\\d{4}/\\d{2}/\\d{2}[ \\t]+MEER AS \\d+ AMPERE[ \\t]{2,}((?<![\\d.,])-?\\d+(?:[ ,]\\d{3})*\\.\\d{2}-?)(?![\\d])[ \\t]{2,}((?<![\\d.,])-?\\d+(?:[ ,]\\d{3})*\\.\\d{2}-?)(?![\\d])[ \\t]*$",
   "type": "money"
  },
  {
   "field": "han_box_rand_r",
   "label": "Meter boxes: RAND column of every tariff row (sum)",
   "scope": "section:electricity",
   "collect": "sum",
   "pattern": "^[ \\t]+\\d+\\.\\d[ \\t]+\\d+\\.\\d{2}[ \\t]+\\d+\\.\\d{3}[ \\t]+((?<![\\d.,])-?\\d+(?:[ ,]\\d{3})*\\.\\d{2}-?)(?![\\d])[ \\t]*$",
   "type": "money"
  },
  {
   "field": "han_meters",
   "label": "Number of ELEK lines (meters)",
   "scope": "section:electricity",
   "collect": "join_unique",
   "pattern": "^[ \\t]*\\d{4}/\\d{2}/\\d{2}[ \\t]+(ELEK)[ \\t]",
   "type": "text"
  }
 ],
 "computes": [
  {
   "field": "site_name",
   "op": "concat",
   "of": [
    "han_erf"
   ]
  },
  {
   "field": "han_elec_ex_r",
   "op": "sum",
   "of": [
    "han_elek_r",
    "han_meer_r"
   ]
  },
  {
   "field": "han_check_r",
   "op": "sum",
   "of": [
    "han_box_rand_r",
    "han_meer_r"
   ]
  }
 ],
 "canonical": {
