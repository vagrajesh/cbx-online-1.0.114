 "short_name": "Pixley Ka Seme",
 "_doc": "Emunsoft 'TAX INVOICE / STATEMENT OF ACCOUNT' print (layout family A): masthead with the municipality's own 'VAT No', Account Number / Account Date / Tax Invoice No / ERF Description / Street block, an optional METER READINGS table (METER NO | TYPE | OLD | NEW | flag A/E/I | CONSUMPTION | LEVIED AMOUNT | READING DATES), then the ACCOUNT DETAILS ledger ('date code DESCRIPTION units@tariff * value', '*' = vatable, credits with a trailing '-'), one VAT line, an aging strip whose last column is the closing balance, and the remittance stub. The electricity section runs from ACCOUNT DETAILS to REMITTANCE ADVICE and exists only when an electricity ledger line is present. total_ex_vat_r = sum of the electricity ledger lines (interest excluded). IDENTITY emu_balance_elec_r = printed closing balance - OPENING BALANCE - every non-electricity ledger line (payments, VAT, interest, other services); it fails if any ledger line is missed or mis-signed. Fingerprint: VAT 4000142390 + name/site. One meter; energy billed in two stepped 'ELECTRICITY' blocks (summed -> standard band), 'ELECTRICITY BASIC CHARGE' and occasional 'CN ELECTRICITY' credit notes (reversal of an earlier month) -> other_r. No tariff name is printed. Interest (dated, undated or CN) is excluded. Result: 10/10 routed, identity exact on 10/10; second check meter LEVIED AMOUNT + basic + credit notes = total on 10/10, VAT/0.15 within 5c. Register advance = CONSUMPTION on 10/10.",
 "fingerprint": {
  "all": [
   "4000142390"
  ],
  "any": [
   "PIXLEY KA ISAKA SEME",
   "pixleykaseme.gov.za"
  ],
  "reject_if_text": []
 },
 "sections": {
  "electricity": {
   "start": "^[ \\t]*ACCOUNT DETAILS[ \\t]*$",
   "require": "^[ \\t]*(?:\\d{2}/\\d{2}/\\d{4}[ \\t]+)?\\w{6}[ \\t]+(?=\\S)(?:(?:CN[ \\t]+)?ELECTRICITY)[^\\n]*?[ \\t]{2,}(-?[\\d,]*\\.\\d{2}-?)[ \\t]*$"
  },
  "sundry": {
   "start": "^[ \\t]*REMITTANCE ADVICE\\b"
  }
 },
