 "short_name": "Umuziwabantu",
 "_doc": "Emunsoft 'TAX INVOICE / STATEMENT OF ACCOUNT' print (layout family A): masthead with the municipality's own 'VAT No', Account Number / Account Date / Tax Invoice No / ERF Description / Street block, an optional METER READINGS table (METER NO | TYPE | OLD | NEW | flag A/E/I | CONSUMPTION | LEVIED AMOUNT | READING DATES), then the ACCOUNT DETAILS ledger ('date code DESCRIPTION units@tariff * value', '*' = vatable, credits with a trailing '-'), one VAT line, an aging strip whose last column is the closing balance, and the remittance stub. The electricity section runs from ACCOUNT DETAILS to REMITTANCE ADVICE and exists only when an electricity ledger line is present. total_ex_vat_r = sum of the electricity ledger lines (interest excluded). IDENTITY emu_balance_elec_r = printed closing balance - OPENING BALANCE - every non-electricity ledger line (payments, VAT, interest, other services); it fails if any ledger line is missed or mis-signed. Fingerprint: VAT 4670112624 + name. Two prints: older ('VAT No:', levied/reading-date columns, 6 bills) and newer ('VAT No.:', a single READING DATE, no LEVIED column, no '@'/'*' markers, a Deposit field, 4 bills); both handled, so read_start is blank on the newer print. 'ELECTRICITY COMM USE' -> standard band, 'LARGE POWER USERS BASIC' -> other_r; refuse removal is a separate refuse row. No kVA printed. Result: 10/10 routed, identity exact on 10/10; on the 6 older bills LEVIED AMOUNT + basic also equals the total. Register advance = CONSUMPTION on 10/10.",
 "fingerprint": {
  "all": [
   "4670112624"
  ],
  "any": [
   "UMUZIWABANTU MUNICIPALITY",
   "Umuziwabantu Local Municipality"
  ],
  "reject_if_text": []
 },
 "sections": {
  "electricity": {
   "start": "^[ \\t]*ACCOUNT DETAILS[ \\t]*$",
   "require": "^[ \\t]*(?:\\d{2}/\\d{2}/\\d{4}[ \\t]+)?\\w{6}[ \\t]+(?=\\S)(?:(?:LARGE POWER USERS|ELECTRICITY))[^\\n]*?[ \\t]{2,}(-?[\\d,]*\\.\\d{2}-?)[ \\t]*$"
  },
  "sundry": {
   "start": "^[ \\t]*REMITTANCE ADVICE\\b"
  },
  "refuse": {
   "start": "^[ \\t]*(?:\\d{2}/\\d{2}/\\d{4}[ \\t]+)?\\w{6}[ \\t]+(?=\\S)REFUSE",
   "overlay": true,
   "end": "$"
  }
 },
