   "ABAQULUSI MUNICIPALITY"
  ]
 },
 "sections": {
  "electricity": {
   "start": "^[ \\t]*METER READINGS[ \\t]*$",
   "overlay": true,
   "end": "^120\\+ DAYS[ \\t]",
   "require": "^[ \\t]*\\d{6,}[ \\t]+ELECTRICITY[ \\t]|ENERGY CHARGE"
  },
  "sewerage": {
   "start": "^[ \\t]*\\d{2}/\\d{2}/\\d{4}[ \\t]+\\d{6}[ \\t]*SEWERAGE",
   "overlay": true,
   "end": "$"
  },
  "sundry": {
   "start": "^[ \\t]*(?:\\d{2}/\\d{2}/\\d{4}[ \\t]+(?:000020|000023)[ \\t]|\\d{6}[ \\t]+INTEREST[ \\t])",
   "overlay": true,
   "end": "^[ \\t]*\\d{6}[ \\t]+INTEREST[^\\n]*$"
  }
 },
