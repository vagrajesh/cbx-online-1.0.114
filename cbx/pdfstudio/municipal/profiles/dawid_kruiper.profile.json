 "short_name": "Dawid Kruiper",
 "_doc": "Emunsoft 'TAX INVOICE/STATEMENT OF ACCOUNT' print (same family as the mogalakwena / pixley_ka_isaka_seme profiles, own rules): masthead with Dawid Kruiper's own 'VAT No.', Account Number / Account Date / Tax Invoice No / ERF Description / Suburb / Street / Deposit block, a METER READINGS table (METER NO | TYPE ELECTRICITY or KVA | OLD | NEW | READING DATE | A/E/I | CONSUMPTION), the ACCOUNT DETAILS ledger ('date code DESCRIPTION units @ tariff * value', credits with trailing '-'), one VAT line, an aging strip whose last column is the closing balance, and the remittance stub. One account with several electricity installations: two circuit-breaker basics (CIRCB ...), a small kWh meter (KWH BUSINESS/INDUSTR ...), a large LV meter (KWH LOW + KVA LOW) and, on one bill, a FINAL USAGE ELECTRICITY line for a removed meter. One electricity row per bill: total_kwh/standard = sum of the billed KWH/FINAL USAGE units and Rands, demand = the KVA LOW line, other_r = the CIRCB basics; meter = the electricity meters joined with '/', read_end = the reading date (no start date or single-meter readings are printed, so start/end readings stay blank). Interest lines and the 'ADMIN FEES - CONVENTIONAL' fee (and its reversal) are left out of electricity. IDENTITY dk_balance_elec_r = closing balance - OPENING BALANCE - every non-electricity ledger line - VAT; it fails if any ledger line is missed or misclassified. Result: 10/10 bills routed, identity exact on 10/10, 0 checks. Fingerprint: the municipality VAT number + its name/website.",
 "fingerprint": {
  "all": [
   "4910103219"
  ],
  "any": [
   "Dawid Kruiper Municipality",
   "dkm.gov.za"
  ],
  "reject_if_text": []
 },
 "sections": {
  "electricity": {
   "start": "^[ \\t]*ACCOUNT DETAILS[ \\t]*$",
   "require": "^[ \\t]*\\d{2}/\\d{2}/\\d{4}[ \\t]+\\w{6}[ \\t]+(?:CIRCB\\b|KWH\\b|KVA\\b|FINAL USAGE ELECTRIC)"
  },
  "sundry": {
   "start": "^[ \\t]*REMITTANCE ADVICE\\b"
  }
 },
 "fields": [
  {
   "field": "account_number",
   "label": "Account Number",
   "scope": "header",
   "pattern": "^[ \\t]*Account Number:[ \\t]*(\\d{6,})\\b",
   "type": "text",
   "required": true
  },
  {
   "field": "billing_date",
   "label": "Account Date",
   "scope": "header",
   "pattern": "Account Date:[ \\t]*(\\d{1,2}[ \\t]+[A-Za-z]{3}[ \\t]+\\d{4})",
   "type": "date",
   "required": true
  },
  {
   "field": "dk_tax_invoice_no",
   "label": "Tax Invoice No",
   "scope": "header",
   "pattern": "Tax Invoice No\\.?:[ \\t]*(\\d{6,})",
   "type": "text"
  },
  {
   "field": "dk_erf",
   "label": "ERF Description",
   "scope": "header",
   "pattern": "ERF Description:[ \\t]*(\\S+(?:[ \\t]\\S+)*)",
   "type": "text"
  },
  {
   "field": "dk_street",
   "label": "Street (site)",
   "scope": "header",
   "pattern": "Street:[ \\t]+(\\S[^\\n]*?)[ \\t]*$",
   "type": "text"
  },
  {
   "field": "dk_suburb",
   "label": "Suburb",
   "scope": "header",
   "pattern": "Suburb:[ \\t]+(\\S[^\\n]*?)[ \\t]*$",
   "type": "text"
  },
  {
   "field": "deposit_r",
   "label": "Deposit",
   "scope": "header",
   "pattern": "Deposit:[ \\t]*([\\d,]*\\.\\d{2})\\b",
   "type": "money"
  },
  {
   "field": "dk_meters",
   "label": "Electricity meters (reading table)",
   "scope": "header",
   "collect": "join_unique",
   "pattern": "^[ \\t]*(\\S+)[ \\t]+ELECTRICITY[ \\t]+[\\d.]+[ \\t]+[\\d.]+[ \\t]+\\d{2}/\\d{2}/\\d{4}[ \\t]+[AEI][ \\t]+[\\d.]+[ \\t]*$",
   "type": "text"
  },
  {
   "field": "dk_meter_kwh",
   "label": "Reading-table consumption, electricity rows (sum)",
   "scope": "header",
   "collect": "sum",
   "pattern": "^[ \\t]*\\S+[ \\t]+ELECTRICITY[ \\t]+[\\d.]+[ \\t]+[\\d.]+[ \\t]+\\d{2}/\\d{2}/\\d{4}[ \\t]+[AEI][ \\t]+([\\d.]+)[ \\t]*$",
   "type": "number"
  },
  {
   "field": "dk_read_date",
   "label": "Reading date (first electricity row)",
   "scope": "header",
   "pattern": "^[ \\t]*\\S+[ \\t]+ELECTRICITY[ \\t]+[\\d.]+[ \\t]+[\\d.]+[ \\t]+(\\d{2}/\\d{2}/\\d{4})[ \\t]+[AEI][ \\t]",
   "type": "date"
  },
  {
   "field": "dk_est_flag",
   "label": "Estimated electricity reading (E)",
   "scope": "header",
   "pattern": "^[ \\t]*\\S+[ \\t]+ELECTRICITY[ \\t]+[\\d.]+[ \\t]+[\\d.]+[ \\t]+\\d{2}/\\d{2}/\\d{4}[ \\t]+(E)[ \\t]",
   "type": "text"
  },
  {
   "field": "dk_act_flag",
   "label": "Actual electricity reading (A)",
   "scope": "header",
   "pattern": "^[ \\t]*\\S+[ \\t]+ELECTRICITY[ \\t]+[\\d.]+[ \\t]+[\\d.]+[ \\t]+\\d{2}/\\d{2}/\\d{4}[ \\t]+(A)[ \\t]",
   "type": "text"
  },
  {
   "field": "dk_kva_reading",
   "label": "KVA meter reading (demand)",
   "scope": "header",
   "pattern": "^[ \\t]*\\S+[ \\t]+KVA[ \\t]+[\\d.]+[ \\t]+[\\d.]+[ \\t]+\\d{2}/\\d{2}/\\d{4}[ \\t]+[AEI][ \\t]+([\\d.]+)[ \\t]*$",
   "type": "number"
  },
  {
   "field": "dk_opening_r",
   "label": "Opening balance",
   "scope": "section:electricity",
   "pattern": "^[ \\t]*OPENING BALANCE[ \\t]{2,}(-?[\\d,]*\\.\\d{2}-?)[ \\t]*$",
   "type": "money",
   "required": true
  },
  {
   "field": "dk_closing_r",
   "label": "Closing balance (last aging column)",
   "scope": "section:electricity",
   "pattern": "^[ \\t]*\\d+\\+[ \\t]*DAYS[^\\n]*CLOSING BALANCE[ \\t]*\\n(?:[ \\t]*\\n)*[ \\t]*(?:\\S+[ \\t]+){5}(-?[\\d,]*\\.\\d{2}-?)[ \\t]*$",
   "type": "money",
   "required": true
  },
  {
   "field": "dk_vat_r",
   "label": "VAT line",
   "scope": "section:electricity",
   "pattern": "^[ \\t]*\\w{6}[ \\t]+VAT[ \\t]{2,}(-?[\\d,]*\\.\\d{2}-?)[ \\t]*$",
   "type": "money"
  },
  {
   "field": "dk_nonelec_lines_r",
   "label": "Dated ledger lines that are not electricity (payments, rates, sewerage, refuse, admin, interest)",
   "scope": "section:electricity",
   "collect": "sum",
   "pattern": "^[ \\t]*\\d{2}/\\d{2}/\\d{4}[ \\t]+\\w{6}[ \\t]+(?!(?:CIRCB\\b|KWH\\b|KVA\\b|FINAL USAGE ELECTRIC))\\S[^\\n]*?[ \\t]{2,}(-?[\\d,]*\\.\\d{2}-?)[ \\t]*$",
   "type": "money"
  },
  {
   "field": "dk_elec_lines_r",
   "label": "Electricity ledger lines (sum)",
   "scope": "section:electricity",
   "collect": "sum",
   "pattern": "^[ \\t]*\\d{2}/\\d{2}/\\d{4}[ \\t]+\\w{6}[ \\t]+(?:CIRCB\\b|KWH\\b|KVA\\b|FINAL USAGE ELECTRIC)[^\\n]*?[ \\t]{2,}(-?[\\d,]*\\.\\d{2}-?)[ \\t]*$",
   "type": "money",
   "required": true
  },
  {
   "fields": [
    "dk_energy_kwh",
    "dk_energy_r"
   ],
   "types": [
    "number",
    "money"
   ],
   "label": "Energy lines (KWH ... / FINAL USAGE ELECTRICITY)",
   "scope": "section:electricity",
   "collect": "sum",
   "pattern": "^[ \\t]*\\d{2}/\\d{2}/\\d{4}[ \\t]+\\w{6}[ \\t]+(?:KWH\\b|FINAL USAGE ELECTRIC)[^\\n]*?[ \\t]{2,}([\\d.]+)[ \\t]+@[ \\t]*[\\d,]*\\.\\d+[ \\t]+\\*?[ \\t]{2,}(-?[\\d,]*\\.\\d{2}-?)[ \\t]*$"
  },
