   ],
   "label": "Demand line (KVA ...)",
   "scope": "section:electricity",
   "collect": "sum",
   "pattern": "^[ \\t]*\\d{2}/\\d{2}/\\d{4}[ \\t]+\\w{6}[ \\t]+KVA\\b[^\\n]*?[ \\t]{2,}([\\d.]+)[ \\t]+@[ \\t]*[\\d,]*\\.\\d+[ \\t]+\\*?[ \\t]{2,}(-?[\\d,]*\\.\\d{2}-?)[ \\t]*$"
  },
  {
   "field": "dk_basic_r",
   "label": "Circuit-breaker basic charges (CIRCB ...)",
   "scope": "section:electricity",
   "collect": "sum",
   "pattern": "^[ \\t]*\\d{2}/\\d{2}/\\d{4}[ \\t]+\\w{6}[ \\t]+CIRCB\\b[^\\n]*?[ \\t]{2,}(-?[\\d,]*\\.\\d{2}-?)[ \\t]*$",
   "type": "money"
  },
  {
   "field": "dk_tariffs",
   "label": "Energy tariff descriptions",
   "scope": "section:electricity",
   "collect": "join_unique",
   "pattern": "^[ \\t]*\\d{2}/\\d{2}/\\d{4}[ \\t]+\\w{6}[ \\t]+((?:KWH\\b|KVA\\b)[^\\n]*?)[ \\t]{2,}[\\d.]+[ \\t]+@",
   "type": "text"
  }
 ],
