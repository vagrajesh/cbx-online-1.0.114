   "pattern": "^[^\\n\\d]*?(?:(20\\d{2}/[01]\\d/[0-3]\\d)|[^\\n]*?)[ \\t]+TARIFF[ \\t]+UNITS[^\\n]*\\n[ \\t]*(\\d{3,7}\\.\\d)[ \\t]+\\d+\\.\\d{2}[ \\t]+(\\d{1,6})\\.000(?![\\d])[^\\n]*\\n[ \\t]*(\\d{3,7}\\.\\d)[ \\t]+0\\.000[^\\n]*\\n[ \\t]*\\3\\.0[ \\t]+0\\.000"
