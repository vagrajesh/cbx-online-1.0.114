    "\\A()()()(?![\\s\\S]*?KTR\\.?[ \\t]+\\d[ \\t]*FASE[\\s\\S]*?KTR\\.?[ \\t]+\\d[ \\t]*FASE)(?![\\s\\S]*?TARIFF)[\\s\\S]*?^[^\\n]*?KTR\\.?[ \\t]+\\d[ \\t]*FASE[ \\t]+\\d+[ \\t]*A[^\\d\\n]{1,12}?(?<![\\d.,\\-])(?=(\\d{1,6})[.,](\\d{2})(?![\\d]))(\\d{1,6}[.,]\\d{2})(?![\\d])[^\\n]{1,25}?(?<![\\d.,])\\4[.,]\\5(?![\\d.,])",
    "\\A(?![\\s\\S]*?KTR\\.?[ \\t]+\\d[ \\t]*FASE[\\s\\S]*?KTR\\.?[ \\t]+\\d[ \\t]*FASE)[\\s\\S]*?^[^\\n]*?KTR\\.?[ \\t]+\\d[ \\t]*FASE[ \\t]+\\d+[ \\t]*A[^\\d\\n]{1,12}?(?<![\\d.,\\-])(?=(\\d{1,6})[.,](\\d{2})(?![\\d]))(\\d{1,6}[.,]\\d{2})(?![\\d])[^\\n]{1,25}?(?<![\\d.,])\\1[.,]\\2(?![\\d.,])[^\\n]*\\n(?=[^\\n]*TARIFF)()()()"
   ]
