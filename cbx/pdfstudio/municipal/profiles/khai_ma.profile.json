   "type": "text",
   "required": true
  },
  {
   "field": "billing_date",
   "label": "Rekening Datum",
   "scope": "document",
   "pattern": "Rekening[ \\t]*Datum:?[ \\t]+(20\\d{2}/[01]\\d/[0-3]\\d)(?![\\d])",
   "type": "date",
   "required": true
  },
  {
   "field": "kha_due_date",
   "label": "Vervaldatum",
   "scope": "document",
   "pattern": "Vervaldatum:?[ \\t]+(20\\d{2}/[01]\\d/[0-3]\\d)(?![\\d])",
