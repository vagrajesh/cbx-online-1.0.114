{
  "profile_id": "steve_tshwete",
  "profile_name": "Steve Tshwete Local Municipality (Middelburg)",
  "short_name": "Steve Tshwete",
  "_doc": "Single ACCOUNT DETAILS table for all services; charge codes are ALPHANUMERIC (00C536). Energy lines 'ELECT: BUS: 1X80' carry billed kWh in UNITS; basics print separately. VAT (code 009008) covers the VATable services only (rates exempt) - used as an independent GT identity in the harness. Meter consumption sum must equal billed kWh.",
  "fingerprint": {
    "all": [
      "STEVE TSHWETE LOCAL MUNICIPALITY"
    ]
  },
  "sections": {
    "electricity": {
      "start": "^\\s*\\d{2}/\\d{2}/\\d{4}\\s+\\w{6}\\s+ELEC"
    },
    "water": {
      "start": "^\\s*\\d{2}/\\d{2}/\\d{4}\\s+\\w{6}\\s+WATER:"
    },
    "sewerage": {
      "start": "^\\s*\\d{2}/\\d{2}/\\d{4}\\s+\\w{6}\\s+SEWERAGE:"
    },
    "refuse": {
      "start": "^\\s*\\d{2}/\\d{2}/\\d{4}\\s+\\w{6}\\s+REFUSE:"
    },
    "rates": {
      "start": "^\\s*\\d{2}/\\d{2}/\\d{4}\\s+\\w{6}\\s+RATES:"
    }
  },
  "fields": [
    {
      "field": "account_number",
