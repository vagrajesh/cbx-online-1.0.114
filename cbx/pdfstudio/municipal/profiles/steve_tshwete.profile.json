        "st_meter_kwh"
      ]
    },
    {
      "field": "standard_kwh",
      "op": "prefer",
      "of": [
        "st_energy_kwh"
      ]
    },
    {
      "field": "standard_r",
      "op": "prefer",
      "of": [
        "st_energy_r"
      ]
    },
    {
      "field": "other_out_r",
      "op": "sum",
      "of": [
        "st_basic_r",
        "st_elec_other_r"
      ]
    },
    {
      "field": "st_elec_ex",
      "op": "sum",
      "of": [
        "st_energy_r",
        "st_basic_r",
        "st_elec_other_r"
      ]
    },
    {
      "field": "st_kwh_out",
