{
 "profile_id": "simola_golf_country_estate",
 "profile_name": "Simola Golf & Country Estate (Knysna) - electricity recharge",
 "short_name": "Simola",
 "_doc": "Simola Golf & Country Estate (Knysna) electricity recharge. Two document types in the folder: 7 one-page Tax Invoices (Document number, Document date, Client code = account, a line table Code | Description | Reference | Quantity | Exclusive | VAT | Inclusive with a 'Basic Charge' line and a 'Consumption' line whose Reference is 'Usage <start> - <end>' readings and whose Quantity is kWh, then a Totals row) and 3 Statements of Account (running ledger only, no charges detail) which route here but produce no electricity row (section requires the Consumption line). Consumption -> standard band, Basic Charge -> other_r; tariff = the consumption item code; no meter number, site or reading dates printed. total_ex_vat_r = basic + consumption exclusive. IDENTITY = printed Totals row Exclusive column: exact on 7/7 invoices. Fingerprint: Simola's VAT number as printed (spaced) + 'Simola Electricity'/website. 0 contradiction checks.",
 "fingerprint": {
  "all": [
   "484 020 451 7"
  ],
  "any": [
   "www.simola.co.za",
   "Simola Electricity"
  ]
 },
 "sections": {
  "electricity": {
   "start": "^Code[ \\t]+Description[ \\t]+Reference[ \\t]+Quantity[ \\t]+Exclusive",
   "require": "^\\S+[ \\t]+Consumption[ \\t]+Usage"
  }
 },
 "fields": [
  {
   "field": "account_number",
   "label": "Client code",
   "scope": "header",
   "pattern": "Client code[ \\t]+([A-Z0-9]{4,})[ \\t]*$"
  },
  {
   "field": "sim_doc_no",
   "label": "Document number",
   "scope": "header",
   "pattern": "Document number[ \\t]+(DIN[ \\t]*\\d+)"
  },
  {
   "field": "billing_date",
   "label": "Document date",
   "scope": "header",
   "patterns": [
    "Document date[ \\t]+(\\d{1,2} [A-Za-z]{3} \\d{4})",
    "\\bclosing on[ \\t]+(\\d{1,2} [A-Za-z]{3} \\d{4})"
   ],
   "type": "date",
   "required": true
  },
  {
   "fields": [
    "tariff_name",
    "sim_start",
    "sim_end",
    "total_kwh",
    "sim_energy_r",
    "sim_energy_vat_r",
    "sim_energy_inc_r"
   ],
   "label": "Consumption line",
   "scope": "section:electricity",
   "pattern": "^(\\S+)[ \\t]+Consumption[ \\t]+Usage[ \\t]+(\\d+(?:\\.\\d+)?)[ \\t]*-[ \\t]*(\\d+(?:\\.\\d+)?)[ \\t]+(\\d+(?:\\.\\d+)?)[ \\t]+unit[ \\t]+(\\(?R[\\d ]*\\d\\.\\d{2}\\)?)[ \\t]+(\\(?R[\\d ]*\\d\\.\\d{2}\\)?)[ \\t]+(\\(?R[\\d ]*\\d\\.\\d{2}\\)?)[ \\t]*$",
   "types": [
    "text",
    "number",
    "number",
    "number",
    "money",
    "money",
    "money"
   ],
   "required": true
  },
  {
   "fields": [
    "sim_basic_r",
    "sim_basic_vat_r",
    "sim_basic_inc_r"
   ],
   "label": "Basic Charge line (summed)",
   "scope": "section:electricity",
   "pattern": "^\\S+[ \\t]+Basic Charge[ \\t]+\\S.*?[ \\t]+\\d+(?:\\.\\d+)?[ \\t]+unit[ \\t]+(\\(?R[\\d ]*\\d\\.\\d{2}\\)?)[ \\t]+(\\(?R[\\d ]*\\d\\.\\d{2}\\)?)[ \\t]+(\\(?R[\\d ]*\\d\\.\\d{2}\\)?)[ \\t]*$",
   "types": [
    "money",
    "money",
    "money"
   ],
   "collect": "sum"
  },
  {
   "fields": [
    "sim_totals_ex_r",
    "sim_totals_vat_r",
    "sim_totals_inc_r"
   ],
   "label": "Totals row (Exclusive / VAT / Inclusive)",
   "scope": "section:electricity",
   "pattern": "^Totals[ \\t]+(\\(?R[\\d ]*\\d\\.\\d{2}\\)?)[ \\t]+(\\(?R[\\d ]*\\d\\.\\d{2}\\)?)[ \\t]+(\\(?R[\\d ]*\\d\\.\\d{2}\\)?)[ \\t]*$",
   "types": [
    "money",
    "money",
    "money"
   ],
   "required": true
  }
 ],
 "computes": [
  {
   "field": "sim_total_ex_r",
   "label": "basic + consumption (ex VAT)",
   "op": "sum",
   "of": [
    "sim_basic_r",
    "sim_energy_r"
   ]
  },
  {
   "field": "sim_kwh_check",
   "op": "diff",
   "of": [
    "sim_end",
    "sim_start"
   ],
   "as": "number"
  }
 ],
 "canonical": {
  "site_name": "_none",
  "billing_date": "billing_date",
