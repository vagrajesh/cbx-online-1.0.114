   "scope": "section:electricity",
   "pattern": "^[ \\t]+(\\d+(?:\\.\\d+)?)[ \\t]*-[ \\t]*(\\d+(?:\\.\\d+)?)[ \\t]*=[ \\t]*(\\d+(?:\\.\\d+)?)[ \\t]+KWH[ \\t]+(\\d+)[ \\t]+DAYS",
