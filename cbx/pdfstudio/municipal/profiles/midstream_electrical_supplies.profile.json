 "short_name": "Midstream Electrical",
 "_doc": "Midstream Electrical Supplies (Pty) Ltd (MES) TOU sub-metering tax invoice to Telkom (folder 'CO YORK STREET & JOUBERT STREET ISAM'). Page 1: account/date/deposit header, history/statement, then the INVOICE block with one line each for Peak / Off-Peak / Standard Elec Usage (meter serial and kWh in the description, Excl and Incl VAT columns) plus fixed lines (Network Charge + StandBy Power Fixed Fee on the 'Commercial TOU' meter type; Standby Charge + Service & Administration Charge + Miniflex Network Charge (R/kVA/Month) on the 'Miniflex MD TOU' type), all summed into other_r; then the tariff structure (meter type = tariff_name). Page 2: meter reading history (AMR) with NMD on the Miniflex layout; the history rows print in ascending OR descending order, so the current reading is the row dated the invoice date (regex back-reference) and the previous reading is its neighbour. Soft hyphens (U+00AD) appear in 'Off-Peak' and dates; patterns tolerate them. Fingerprint: MES's own VAT number + name/e-mail domain. Identity mes_total_check_r = printed invoice Total (incl) - (sum of incl lines - sum of excl lines) vs sum of excl lines: 8 bills 0.00, 2 within R0.01. Checked on 10 bills (one is a single-page 'COPY OF INVOICE' without deposit or reading history; two files are the same invoice), 0 contradiction checks.",
 "fingerprint": {
  "all": [
   "4590209534"
  ],
  "any": [
   "MIDSTREAM ELECTRICAL SUPPLIES"
  ]
 },
 "sections": {
  "electricity": {
   "start": "^[ \\t]*INVOICE NO\\.[ \\t]",
   "require": "Elec Usage \\("
  }
 },
 "fields": [
  {
   "field": "account_number",
   "label": "ACCOUNT (landlord account ref)",
   "scope": "header",
   "pattern": "\\bACCOUNT[ \\t]+([A-Z0-9]{5,})[ \\t]+DATE\\b",
   "type": "text",
   "required": true
  },
  {
   "field": "billing_date",
   "label": "Statement DATE",
   "scope": "header",
   "pattern": "\\bACCOUNT[ \\t]+[A-Z0-9]{5,}[ \\t]+DATE[ \\t]+(\\d{1,2} [A-Za-z]{3} \\d{4})",
   "type": "date",
   "required": true
  },
  {
   "field": "mes_invoice_no",
   "label": "Invoice no.",
   "scope": "section:electricity",
   "pattern": "^[ \\t]*INVOICE NO\\.[ \\t]+(\\S+)",
   "type": "text"
  },
  {
   "field": "mes_deposit_r",
   "label": "Deposit",
   "scope": "header",
   "pattern": "\\bDEPOSIT[ \\t]+R[ \\t]*(-?[\\d,]+\\.\\d{2})",
   "type": "money"
  },
  {
   "field": "site_name",
   "label": "Street address (site)",
   "scope": "header",
   "pattern": "^[ \\t]*STAND NO\\.[ \\t]+STREET ADDRESS[ \\t]*\\n[ \\t]*\\S+[ \\t]{2,}(\\S[^\\n]*?)[ \\t]*$",
   "type": "text"
  },
  {
   "fields": [
    "peak_kwh",
    "peak_r",
    "mes_peak_inc_r"
   ],
   "types": [
    "number",
    "money",
    "money"
   ],
   "label": "Peak usage kWh / excl / incl",
   "scope": "section:electricity",
   "pattern": "^[ \\t]*\\d{1,2} [A-Za-z]{3} \\d{4}[ \\t]+Peak Elec Usage \\(\\d+\\)\\W?[A-Z]?:[ \\t]*([\\d.,]+)[ \\t]*kWh[ \\t]+R[ \\t]*(-?[\\d,]+\\.\\d{2})[ \\t]+R[ \\t]*(-?[\\d,]+\\.\\d{2})[ \\t]*$",
   "collect": "sum",
   "required": true
  },
  {
   "fields": [
    "offpeak_kwh",
    "offpeak_r",
    "mes_off_inc_r"
   ],
   "types": [
    "number",
    "money",
    "money"
   ],
   "label": "Off-peak usage kWh / excl / incl",
   "scope": "section:electricity",
   "pattern": "^[ \\t]*\\d{1,2} [A-Za-z]{3} \\d{4}[ \\t]+Off\\W?Peak Elec Usage \\(\\d+\\)\\W?[A-Z]?:[ \\t]*([\\d.,]+)[ \\t]*kWh[ \\t]+R[ \\t]*(-?[\\d,]+\\.\\d{2})[ \\t]+R[ \\t]*(-?[\\d,]+\\.\\d{2})[ \\t]*$",
   "collect": "sum",
   "required": true
  },
  {
   "fields": [
    "standard_kwh",
    "standard_r",
    "mes_std_inc_r"
   ],
   "types": [
    "number",
    "money",
    "money"
   ],
   "label": "Standard usage kWh / excl / incl",
   "scope": "section:electricity",
   "pattern": "^[ \\t]*\\d{1,2} [A-Za-z]{3} \\d{4}[ \\t]+Standard Elec Usage \\(\\d+\\)\\W?[A-Z]?:[ \\t]*([\\d.,]+)[ \\t]*kWh[ \\t]+R[ \\t]*(-?[\\d,]+\\.\\d{2})[ \\t]+R[ \\t]*(-?[\\d,]+\\.\\d{2})[ \\t]*$",
   "collect": "sum",
   "required": true
  },
  {
   "fields": [
    "other_r",
    "mes_other_inc_r"
   ],
   "types": [
    "money",
    "money"
   ],
   "label": "Fixed lines (network / standby / service & admin) excl / incl",
   "scope": "section:electricity",
   "pattern": "^[ \\t]*\\d{1,2} [A-Za-z]{3} \\d{4}[ \\t]+(?!(?:Peak|Off\\W?Peak|Standard) Elec Usage)[A-Za-z][^\\n]*?[ \\t]{2,}R[ \\t]*(-?[\\d,]+\\.\\d{2})[ \\t]+R[ \\t]*(-?[\\d,]+\\.\\d{2})[ \\t]*$",
   "collect": "sum",
   "required": true
  },
  {
