    "date",
    "number",
    "number",
    "number"
   ],
   "label": "History rows ascending: row before the invoice-date row = previous reading",
   "scope": "section:electricity",
   "pattern": "^[ \\t]*(\\d{1,2} [A-Za-z]{3} \\d{4})[ \\t]+Peak Elec Usage[\\s\\S]*?^[ \\t]+(\\d{1,2} [A-Za-z]{3} \\d{4}) \\d{2}:\\d{2}[ \\t]+([\\d,]+\\.\\d)[ \\t]+[\\d,.]+[ \\t]+[A-Za-z]+[ \\t]+\\d+[ \\t]*\\n[ \\t]+\\1 \\d{2}:\\d{2}[ \\t]+([\\d,]+\\.\\d)[ \\t]+([\\d,.]+)[ \\t]"
  },
  {
   "fields": [
    "mes_inv_date_b",
    "mes_b_end",
    "mes_b_usage",
