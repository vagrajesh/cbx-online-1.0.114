    "mes_b_start"
   ],
   "types": [
    "date",
    "number",
    "number",
    "date",
    "number"
   ],
   "label": "History rows descending: row after the invoice-date row = previous reading",
   "scope": "section:electricity",
   "pattern": "^[ \\t]*(\\d{1,2} [A-Za-z]{3} \\d{4})[ \\t]+Peak Elec Usage[\\s\\S]*?^[ \\t]+\\1 \\d{2}:\\d{2}[ \\t]+([\\d,]+\\.\\d)[ \\t]+([\\d,.]+)[ \\t]+[A-Za-z]+[ \\t]+\\d+[ \\t]*\\n[ \\t]+(\\d{1,2} [A-Za-z]{3} \\d{4}) \\d{2}:\\d{2}[ \\t]+([\\d,]+\\.\\d)[ \\t]"
  }
 ],
 "computes": [
