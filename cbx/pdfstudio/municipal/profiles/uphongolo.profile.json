 ],
 "computes": [
  {
   "field": "uph_ebasic_ex_r",
   "op": "sub",
   "of": [
    "uph_ebasic_inc_r",
    "uph_ebasic_vat_r"
   ]
  },
  {
   "field": "uph_kwh_ex_calc_r",
   "op": "sub",
   "of": [
    "uph_kwh_inc_r",
    "uph_kwh_vat_r"
   ]
  },
  {
   "field": "uph_kva_ex_calc_r",
   "op": "sub",
   "of": [
    "uph_kva_inc_r",
    "uph_kva_vat_r"
   ]
  },
  {
   "field": "uph_std_r_out",
   "op": "prefer",
   "of": [
    "uph_kwh_excl_r",
    "uph_kwh_ex_calc_r"
   ]
  },
  {
   "field": "uph_demand_r_out",
   "op": "prefer",
   "of": [
    "uph_kva_excl_r",
    "uph_kva_ex_calc_r"
   ]
  },
  {
   "field": "uph_elec_total_ex_r",
   "op": "sum",
   "of": [
    "uph_std_r_out",
    "uph_demand_r_out",
    "uph_ebasic_ex_r"
   ]
  },
  {
   "field": "uph_elec_vat_r",
   "op": "sum",
   "of": [
    "uph_kwh_vat_r",
    "uph_kva_vat_r",
    "uph_ebasic_vat_r"
   ]
  },
  {
   "field": "uph_elec_total_inc_r",
   "op": "sum",
   "of": [
    "uph_kwh_inc_r",
    "uph_kva_inc_r",
    "uph_ebasic_inc_r"
   ]
  },
  {
   "field": "uph_kwh_excl_delta",
   "op": "diff",
   "of": [
    "uph_kwh_excl_r",
    "uph_kwh_ex_calc_r"
   ]
  },
  {
   "field": "uph_kva_excl_delta",
   "op": "diff",
   "of": [
    "uph_kva_excl_r",
    "uph_kva_ex_calc_r"
   ]
  },
  {
   "field": "uph_reading_kwh",
   "op": "diff",
   "as": "number",
   "of": [
    "end_reading_kwh",
    "start_reading_kwh"
   ]
  },
  {
   "field": "uph_rates_ex_r",
   "op": "sub",
   "of": [
    "uph_rates_inc_r",
    "uph_rates_vat_r"
   ]
  },
  {
   "field": "uph_rental_ex_r",
   "op": "sub",
   "of": [
    "uph_rental_inc_r",
    "uph_rental_vat_r"
   ]
  }
 ],
