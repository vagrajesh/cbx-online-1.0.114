# CBX-Connect settings. Copy to .env and edit. Every line is optional.

# Where the database, warehouse files, spans cache, versions and backups live.
# Default: the "data" folder next to this file. Put it on the big drive.
CBX_DATA_DIR=data

# Port the app listens on. Open http://<server-name>:8080 from any PC on the LAN.
CBX_PORT=8080
# The server's own name and LAN IP are always accepted. Add any extra names people will type
# (e.g. a DNS alias like cbx.cbreexcellerate.local), comma-separated.
CBX_ALLOWED_HOSTS=localhost,127.0.0.1

# Database. Leave empty for SQLite (zero install). For Postgres:
# CBX_DATABASE_URL=postgresql+psycopg://cbx:password@localhost:5432/cbx
CBX_DATABASE_URL=

# C-EXA's models (Ollama on this machine).
CBX_OLLAMA_URL=http://127.0.0.1:11434
# (CBX_AXL_MODEL, the name before 1.0.49, still works.)
CBX_CEXA_MODEL=qwen3.8:27b
CBX_WORKER_MODEL=qwen3.5:9b
CBX_OCR_MODEL=glm-ocr
# live = use Ollama; stub = no model (rules only, fixed replies)
CBX_MODEL_MODE=live
# How C-EXA talks vs how she works. 0 = identical, exact answers every time; 2 = maximum variety (Ollama's ceiling).
# voice = chat replies, briefs, asides · code = anything that becomes code · data = reading PDFs, scoring, choosing tools
CBX_TEMP_VOICE=2.0
CBX_TEMP_CODE=0.0
CBX_TEMP_DATA=0.1
CBX_MODEL_BATCH_CEILING_ZAR=50

# ---- C-EXA's team (1.0.49) — the Agents page ----
# The model each role uses. Empty = the same as CBX_CEXA_MODEL. The designer looks at screenshots, so
# hers must be a model that can see (qwen3.8:27b can); the helper does small jobs — a smaller one is fine.
CBX_MODEL_DEVELOPER=
CBX_MODEL_DESIGNER=
CBX_MODEL_HELPER=

# 1.0.62 — C-EXA's agents. Pick the model for each kind of bot on Agents → Now → Models; these are only
# the fall-backs (empty = CBX_CEXA_MODEL). A small model with tools is plenty for helpers and writers.
CBX_MODEL_WORKER_TIER=
CBX_MODEL_LIGHT_TIER=
CBX_AGENT_MAX_STEPS=12
CBX_AGENT_CALLS_PER_DAY=400
# The heartbeat: a light check every N minutes (no model unless something new), a deep one at night.
CBX_HEARTBEAT=true
CBX_HEARTBEAT_MINUTES=15
CBX_HEARTBEAT_DEEP_AT=01:30
# Web search for C-EXA (Ollama's web search; make a free account at ollama.com → Keys). Her searches
# never carry rows, names, e-mail addresses or numbers. Leave empty to keep her off the web.
CBX_OLLAMA_API_KEY=
CBX_WEB_SEARCHES_PER_HOUR=30

# 1.0.64 — C-EXA's ears (Whisper) and voice (Kokoro), on this server; nothing leaves the building.
# Agents → Now → Voice → Set up voice installs them. Empty voice = bf_emma (British English).
CBX_VOICE=true
CBX_VOICE_STT_MODEL=large-v3-turbo
CBX_VOICE_STT_CPU_MODEL=small
CBX_VOICE_TTS_VOICE=
CBX_CALL_RING_SECONDS=60
# The most model calls one job may spend before C-EXA pauses it and asks you (Carry on gives 50 more).
CBX_TEAM_MAX_CALLS=150
# The designer's screenshots of draft pages (needs Playwright + Chromium: Agents -> Screenshots off -> Turn on).
CBX_TEAM_SCREENSHOTS=true
# The standing teams (1.0.50) run on their own schedules, and Governance reviews every tested version. false = only when started from the Agents page.
CBX_TEAMS_AUTO=true

# Scanned PDFs (no text layer) need Tesseract OCR. Windows installer: https://github.com/UB-Mannheim/tesseract/wiki
# then point CBX at it (leave empty or commented out if tesseract is on PATH or not installed):
# CBX_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Scheduled flows (Jobs, 1.0.48) start by themselves on this server. A sandbox sets this false.
CBX_FLOWS_SCHEDULE=true

# OneDrive / SharePoint mirror — see docs/onedrive-setup.md
CBX_ONEDRIVE_ENABLED=false
CBX_GRAPH_TENANT_ID=
CBX_GRAPH_CLIENT_ID=
CBX_GRAPH_CLIENT_SECRET=
CBX_GRAPH_DRIVE_ID=
CBX_ONEDRIVE_ROOT=CBX Warehouse

# ---------------------------------------------------------------------------------------------
# Email. Reminders, sign-in codes and digests all go through this.
#
# Fill these in, restart, then send yourself a test from Settings -> Email. Nothing else to do:
# sign-in codes stay off until that test actually arrives, so a wrong app password or a blocked port
# cannot lock anyone out. Leave CBX_MAIL_ONLY_TO pointed at yourself for the first week so nothing
# reaches a colleague by accident.
CBX_MAIL_ENABLED=false
CBX_MAIL_FROM=cbx-connect@cbreexcellerate.com
CBX_SMTP_HOST=
CBX_SMTP_PORT=587
CBX_SMTP_STARTTLS=true
CBX_SMTP_USER=
CBX_SMTP_PASSWORD=
# Every message goes here instead of the real recipient, with [test] in the subject and a line
# naming who it would have gone to. Empty = send for real.
CBX_MAIL_ONLY_TO=
# Stops a loop or a bad import from mailing the company a thousand times.
CBX_MAIL_DAILY_CAP=200
# The address people open the app at — links in emails ("open this document") point here, e.g.
# https://cbx.example.com or the tunnel address. Empty = the address the last admin signed in from.
CBX_PUBLIC_URL=

# Signing in from a browser we have not seen emails a 6-digit code, then trusts that browser for
# CBX_DEVICE_TRUST_DAYS. This switches itself on the first time a message really leaves this server
# and not before, so leaving it true costs nothing until email is working.
CBX_DEVICE_VERIFICATION=true
CBX_DEVICE_TRUST_DAYS=30
# When a code cannot be emailed (mail not set up, the password wrong, the server down): "terminal" shows
# it in the CBX window on the server and to owners/admins in Users & roles, and the person still has to
# type it (the default since 1.0.47); "let_in" is the old way — sign-in goes ahead without the code and
# the gap is written to the audit trail.
CBX_CODE_FALLBACK=terminal
# Wrong passwords and code attempts allowed per IP address per window (seconds).
CBX_LOGIN_RATE_LIMIT=10
CBX_LOGIN_RATE_WINDOW_SECONDS=900
# A wrong-password lock lifts itself after this many minutes. The last owner is never locked out.
CBX_LOGIN_LOCKOUT_MINUTES=15

# Set to true once the app is behind HTTPS.
# Cookies are marked Secure on their own for any request that arrived over HTTPS (the tunnel, a real
# certificate). true forces it for every request — right once the LAN address is HTTPS as well.
CBX_SECURE_COOKIES=false
# Peers allowed to say who the real client is (X-Forwarded-For / -Proto): the ngrok agent and any
# reverse proxy on this machine. Comma-separated addresses. Anyone else's forwarded headers are ignored.
CBX_TRUSTED_PROXIES=127.0.0.1,::1
# Per-file cap for attachments, branding images and quotations (the warehouse's own
# upload door keeps its 200 MB).
CBX_MAX_ATTACHMENT_MB=25
# API connections may point at the company's own private network (10.x, 172.16-31.x, 192.168.x) only
# when this is true. Loopback and link-local addresses are never allowed.
CBX_API_ALLOW_PRIVATE=false
CBX_SESSION_IDLE_HOURS=8

# Branding — these are the DEFAULTS. The owner can change every one of them from Settings -> Branding
# in the app (saved in data\branding\branding.json, kept across updates), so editing this file is optional.
CBX_PRODUCT_NAME=CBX-Connect
CBX_ORG_NAME=CBRE Excellerate
CBX_TAGLINE=Digital & Transformation
# What the AI controller is called on screen and in her own messages (e.g. HRMS).
CBX_AI_NAME=C-EXA
# Logo (white lettering on a transparent PNG/SVG looks best — it sits in the dark green tile) and browser-tab icon.
# Put your files at data\branding\logo.png and data\branding\favicon.png (samples in web\branding-samples\).
CBX_LOGO_FILE=data\branding\logo.png
CBX_FAVICON_FILE=data\branding\favicon.png
# Optional accent colour (hex). Empty = the stylesheet's green.
CBX_ACCENT=

# C-EXA's hands in the sandbox (read/patch/write files, pytest, ruff, git, run the sandbox app) — all
# inside a proposal's sandbox copy, never the live app. Set to 0 to switch them off entirely.
CBX_CEXA_HANDS=1

# ---- Two-step verification (1.0.45) ----
# Who must have a second step: everyone | admins | none. An authenticator app is the default; a code
# to the inbox may be chosen instead when CBX_MFA_EMAIL_FALLBACK is true (people without an app, and
# people outside the company). Owners and admins are asked on every sign-in unless this is raised.
# Three wrong codes in a row lock the account until an owner or admin unlocks it.
CBX_MFA_REQUIRED=everyone
CBX_MFA_EMAIL_FALLBACK=true
CBX_MFA_ADMIN_TRUST_DAYS=0
CBX_MFA_MAX_FAILED=3

# Nightly backup of the data (1.0.58). Empty folder = data\backups\data; better another disk or a synced share.
CBX_BACKUPS=true
CBX_BACKUP_DIR=
CBX_BACKUP_AT=01:30
CBX_BACKUP_KEEP_DAYS=14

# 1.0.59: other systems may read a table with a key (Connections -> Keys for our data).
# Keys are refused over plain HTTP (except from this machine). Set false only on a closed network.
CBX_DATA_KEYS_HTTPS_ONLY=true

# 1.0.66 Support tickets by mail, and mail through Outlook (until SMTP works).
# Outlook must be open on THIS PC with the mailbox below in it. Mail then leaves from that mailbox, and
# with CBX_SUPPORT_MAIL=true new mail in its Inbox becomes tickets (each read mail gets the category "CBX").
#CBX_MAIL_ENABLED=true
#CBX_MAIL_TRANSPORT=outlook
#CBX_OUTLOOK_MAILBOX=cbx-connect@cbreexcellerate.com
#CBX_OUTLOOK_FOLDER=Inbox
#CBX_SUPPORT_MAIL=true

# 1.0.68 the studio voice (graphics card), set up from Agents → Now → Voice
#CBX_VOICE_STUDIO=true
#CBX_VOICE_STUDIO_PORT=8099
